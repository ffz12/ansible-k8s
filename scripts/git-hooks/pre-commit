#!/bin/bash
# ============================================================================
#  pre-commit —— 拦住明文密码 / 私钥进库
#
#  背景: 统一登录密码按明文保存(不做 vault 加密), 文件靠
#        .gitignore 排除。但 .gitignore 拦不住 `git add -f`, 也拦不住
#        "顺手把密码贴到某个 yaml 里" 这种情况。而密码一旦进了 git 历史
#        就删不掉 —— 后面改了密码, 旧提交里那一份还在。所以在提交时兜一道。
#
#  安装(init.sh 会自动做):
#      cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#      chmod +x .git/hooks/pre-commit
#
#  应急放行(确认是误报时):
#      git commit --no-verify
#  或整体关掉:  git config secretscan.skip true
# ============================================================================
set -u

RED=$'\033[0;31m'; YEL=$'\033[0;33m'; GRN=$'\033[0;32m'; NC=$'\033[0m'

[ "$(git config --get secretscan.skip 2>/dev/null)" = "true" ] && exit 0

# 只看本次暂存的内容; -z + 手工分割, 兼容带空格/中文的路径
mapfile -d '' STAGED < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#STAGED[@]}" -eq 0 ] && exit 0

fail=0

# ---------------------------------------------------------------------------
# 1) 整个文件本就不该入库(即便加密过也不入库)
# ---------------------------------------------------------------------------
FORBIDDEN_PATHS='^(inventory/os-secrets\.yml|inventory/hosts|inventory/group_vars/all/env\.yaml)$'

for f in "${STAGED[@]}"; do
    if printf '%s' "$f" | grep -qE "$FORBIDDEN_PATHS"; then
        [ "$fail" -eq 0 ] && printf '\n%s[pre-commit 拦截]%s 检测到不应入库的文件:\n' "$RED" "$NC"
        fail=1
        printf '  %s\n' "$f"
        printf '      这是本地实际配置(含明文密码), 已在 .gitignore 里。\n'
        printf '      取消暂存: git restore --staged %s\n' "$f"
    fi
done

# ---------------------------------------------------------------------------
# 2) 私钥
# ---------------------------------------------------------------------------
for f in "${STAGED[@]}"; do
    if git show ":$f" 2>/dev/null | grep -qE 'BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY'; then
        printf '\n%s[pre-commit 拦截]%s %s 里有私钥。\n' "$RED" "$NC" "$f"
        fail=1
    fi
done

# ---------------------------------------------------------------------------
# 3) 密码字段被赋了【真实值】
#    模板里的占位符要放过去, 否则 tmp/*.example 永远提交不了。
# ---------------------------------------------------------------------------
PW_KEYS='osacct_user_password|osacct_root_password|qdlt_user_password|qdlt_root_password|bootstrap_ssh_pass|bootstrap_become_pass|ansible_ssh_pass|ansible_password|ansible_become_pass|harbor_admin_password'

# 厂商公开的默认口令白名单。这些是文档里印着的初始密码, 不是"泄露"——
# Harbor12345 是 Harbor 官方 harbor.yml 里的默认 admin 密码, root123 同理是
# 本仓库模板一直以来的示例值(都带"建议改"注释, 部署时必须改掉)。
# ⚠ 白名单只放【全网公开的固定默认值】, 别往里加真实环境用过的密码。
KNOWN_DEFAULTS='Harbor12345|root123|admin123|Changeme123|changeme|password'

# 占位符特征: 中文说明 / xxx / 在此填写 / 空串 / {{ 变量 }} / 纯注释行 / 厂商默认口令
is_placeholder() {
    local v="$1"
    [ -z "$v" ] && return 0
    printf '%s' "$v" | grep -qE '^('"$KNOWN_DEFAULTS"')$' && return 0
    # 值里含【非 ASCII 可打印字符】(中文/全角标点等) → 占位符。
    # ⚠ 这一条替代了原来逐词枚举中文的做法(在此填写|请填|改成|示例|...)——
    #   枚举必漏: 写 '密码' / '统一登录密码' / '实际密码' 都不在词表里, 全被误拦。
    #   通则是: Linux 登录密码不可能是中文, 所以含中文即占位符。
    #   下面那条 grep -E 的中文词表保留着做兜底(值里中英混排时仍能命中)。
    # ⚠ 用 [^ -~] 而不是 grep -P '[\x{4e00}-\x{9fff}]' —— 本仓库 Windows/Git Bash
    #   环境的 grep 报 "character value in \x{} is too large", -P 的码点区间用不了;
    #   [^ -~] 只依赖 ASCII 区间, 不依赖 PCRE 也不依赖 locale。
    #   实测: 密码/统一登录密码/实际密码/另一个密码 → 放过;
    #        Aa1@bcdefg / P@ssw0rd! 这类纯 ASCII → 照旧按真实密码拦。
    printf '%s' "$v" | LC_ALL=C grep -q '[^ -~]' && return 0
    printf '%s' "$v" | grep -qE '^(""|'"''"'|xxx+|XXX+|<.*>|\{\{.*\}\}|.*(在此填写|请填|填写|改成|示例|明文密码|你的|自己的).*)$' && return 0
    # {{ ... }} 里可能跨行(YAML 折叠标量), 只要值整体是一个 Jinja 表达式就算占位符
    printf '%s' "$v" | grep -qE '^\{\{.*\}\}$' && return 0
    return 1
}

# YAML 折叠/字面标量: `key: >-` / `|-` / `>` / `|` 后面的值在【下面几行缩进块】里。
# 只看 key 那一行会把 ">-" 本身当成 2 个字符的密码 —— 必须先把块折起来。
# 用 awk 把 "PW_KEY: <块标量指示符>" 折成单行 "PW_KEY: <块内容>"。
fold_block_scalars() {
    awk -v keys="$PW_KEYS" '
    function flush() { if (pend != "") { print pend " " buf; pend=""; buf="" } }
    {
        line = $0
        # 正在收集块内容: 缩进比 key 深就继续拼, 否则结束
        if (pend != "") {
            if (line ~ /^[[:space:]]*$/) { next }
            match(line, /^[[:space:]]*/)
            if (RLENGTH > keyindent) {
                s = line; sub(/^[[:space:]]+/, "", s)
                buf = (buf == "" ? s : buf " " s)
                next
            }
            flush()
        }
        # 新的 "key: >-" / "key: |" 形式
        if (line ~ "^[[:space:]]*(" keys ")[[:space:]]*:[[:space:]]*[|>][-+]?[[:space:]]*$") {
            match(line, /^[[:space:]]*/); keyindent = RLENGTH
            pend = line; sub(/[[:space:]]*[|>][-+]?[[:space:]]*$/, ":", pend)
            sub(/::$/, ":", pend)
            buf = ""
            next
        }
        print line
    }
    END { flush() }'
}

for f in "${STAGED[@]}"; do
    # 只扫文本文件
    git show ":$f" 2>/dev/null | head -c 1024 | grep -qI . || continue

    while IFS= read -r line; do
        # 跳过注释行(# 或 //)
        printf '%s' "$line" | grep -qE '^\s*(#|//)' && continue
        # 取 : 或 = 右边的值, 去掉引号和行尾注释
        # 注: 行尾注释只在【值不含 {{ }}】时剥, 否则 "{{ a | default('#x') }}" 会被截断
        val=$(printf '%s' "$line" | sed -E 's/^[^:=]*[:=][[:space:]]*//')
        printf '%s' "$val" | grep -q '{{' || val=$(printf '%s' "$val" | sed -E 's/[[:space:]]*#.*$//')
        val=$(printf '%s' "$val" \
              | sed -E 's/^"(.*)"$/\1/; s/^'"'"'(.*)'"'"'$/\1/' \
              | sed -E 's/[[:space:]]+$//')
        if ! is_placeholder "$val"; then
            [ "$fail" -eq 0 ] && printf '\n%s[pre-commit 拦截]%s 检测到疑似明文密码:\n' "$RED" "$NC"
            fail=1
            # 不回显密码本体, 只给位置和长度
            key=$(printf '%s' "$line" | sed -E 's/[[:space:]]*([A-Za-z_]+)[[:space:]]*[:=].*/\1/')
            printf '  %s : %s = <%d 个字符, 非占位符>\n' "$f" "$key" "${#val}"
        fi
    done < <(git show ":$f" 2>/dev/null | fold_block_scalars \
             | grep -E "^[[:space:]]*($PW_KEYS)[[:space:]]*[:=]")
done

if [ "$fail" -ne 0 ]; then
    cat <<EOF

${YEL}为什么要拦:${NC} 密码进了 git 历史就删不掉。即便下一个提交删掉它,
旧提交里那一份还在, 改密码也追不回来 —— 只能重写历史或换密码。

处置:
  1) 取消暂存该文件, 密码只留在 .gitignore 覆盖的本地文件里
  2) 确认是误报:  git commit --no-verify
  3) 长期关掉扫描:  git config secretscan.skip true

EOF
    exit 1
fi

printf '%s[pre-commit]%s 密码/私钥扫描通过 (%d 个文件)\n' "$GRN" "$NC" "${#STAGED[@]}"
exit 0
