# ============================================================================
#  青岛联通项目 inventory 模板 —— 复制为 inventory/hosts 后按实际填写
#
#  组说明:
#    [qdlt]      本次交付的全部节点(qdlt-init / qdlt-check 都跑这个组)
#    [qdlt_cpu]  CPU 管理节点 → 主机名 CPU-<IP末段3位>
#    [qdlt_gpu]  GPU 算力节点 → 主机名 GPU-SU<n>-<IP末段3位>, 必须逐台指定 qdlt_su
#
#  ⚠ qdlt_su 依据服务器上连的计算网 Leaf 交换机组顺序决定, 需对照接线表填写。
# ============================================================================

[qdlt_cpu]
# 主机名建议直接写成交付标准要求的目标名, 便于核对
CPU-229 ansible_host=10.82.4.229
#CPU-230 ansible_host=10.82.4.230

[qdlt_gpu]
# GPU 节点示例(本期若不交付 GPU 节点, 本组留空即可)
#GPU-SU1-056 ansible_host=10.82.4.56  qdlt_su=1
#GPU-SU1-057 ansible_host=10.82.4.57  qdlt_su=1
#GPU-SU2-058 ansible_host=10.82.4.58  qdlt_su=2

[qdlt:children]
qdlt_cpu
qdlt_gpu

[qdlt_cpu:vars]
qdlt_node_role=cpu

[qdlt_gpu:vars]
qdlt_node_role=gpu

[qdlt:vars]
# 连接身份由 group_vars/all/connection.yaml 自动探测(root 免密 → root; 否则 用户+sudo)。
# 首次进场机器通常只有厂商初始账号, 在 group_vars/all/env.yaml 里配 bootstrap_* 即可。
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
