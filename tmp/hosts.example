# inventory 主机清单模板 —— 复制为 inventory/hosts 并按实际填写(去掉行首 #)

[cluster]
# 所有节点; 可带自定义变量 ipmi_ip / storage_ip
#a800-node30 ansible_host=10.42.1.30
#cpu06 ansible_host=10.2.0.16 ipmi_ip=10.0.0.160 storage_ip=10.20.4.31

[docker_cpu]
# 装 docker 的 CPU 节点
#cpu01

[docker_gpu]
# 装 docker 的 GPU 节点
#a800-node30

[cri_docker_nodes]
# cri-dockerd 已弃用,留空

[containerd]
# 用 containerd 的节点; accelerator_type 行内设(nvidia/dcu/npu; 不指定=默认 runc)
#a800-node30 accelerator_type=nvidia

[harbor]
# Harbor 节点
#10.2.0.15

[k8slb]
# haproxy+keepalived LB 节点; host_ip 行内设(用于探测 VIP 网卡)
#10.2.0.11 host_ip=10.2.0.11
#10.2.0.12 host_ip=10.2.0.12
#10.2.0.13 host_ip=10.2.0.13

[k8s_master]
# k8s master 节点(nginx-ha 方案的 keepalived priority 会用到)
#a800-node30 ansible_host=10.42.1.30

[all:vars]
# 时钟同步 NTP 源
#chrony_ip=10.5.0.6
# k8slb 虚拟 IP(VIP)
#lbvip=10.2.1.251
# VIP 掩码(默认 22),按实际网段改
#vip_prefix=22

# 连接方式:
# 【还没配 root 免密】用普通用户 + sudo:
#ansible_user=user
#ansible_ssh_pass=Admin@123+
#ansible_become=true
#ansible_become_method=sudo
#ansible_become_pass=Admin@123+
#ansible_python_interpreter=/usr/bin/python3
#ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
# 【已提供 root 且免密】上面 ssh_pass / become* 那几行可省
