# inventory 主机清单模板 —— 复制为 inventory/hosts 按实际填写(去行首 #)
# 约定: 机器只写一次(ansible_host 等), 别的组只列主机名; 同名=同一台。
# 详见 docs/主机初始化-os-init.md
# ============================================================================

# 全部机器写在这。⚠ policy=inventory 时, 这里写的名字就是机器最终主机名
[cluster]
#cpu-001 ansible_host=192.168.1.111
#gpu-su1-001 ansible_host=10.82.4.56  osinit_su=1
# 多网卡节点: kubelet 默认按「默认路由网卡」自选 Node IP, 可能选错(如落到 10.101.16.x)。
# 默认已把 kubelet --node-ip 钉成 ansible_host; 若 k8s InternalIP 要用与 SSH 不同的地址,
# 单独指定: #cpu06 ansible_host=172.18.1.66 kube_node_ip=172.18.1.66

[init]
# 要跑系统初始化(init.yaml)的节点(只列主机名; 同名=同一台, 机器本体仍写在 [cluster])。
# 加新节点时把新机名填这, init.yaml 只初始化它, 不动已交付的老机器。
#cpu-005

[containerd]
# 用 containerd 的节点(只列主机名); GPU/加速器节点加 accelerator_type=nvidia/dcu/npu(华为昇腾), 纯 CPU 不写(默认 runc)
#cpu-001
#
# ---- accelerator_type: 一处声明, 三处生效 ----
# 它不只决定装什么运行时, 还决定 calico 双池怎么分池, 所以【GPU 机器务必写】:
#   ① containerd: accelerator_type=nvidia -> 装 nvidia-container-toolkit(见 container-toolkit 角色)
#   ② docker    : 同上(见 [docker] 组的说明)
#   ③ calico 双池: nvidia/dcu/npu -> 打 hardware=gpu 标签; 不写或 none -> hardware=cpu
#      标签由 kube-init-master / kube-add-node / kube-add-master 自动打(仅
#      calico_dual_ippool_enabled=true 时), 不用手工 kubectl label。
#
# ---- calico_pool: 只覆盖"分到哪个 Pod 网段", 不影响运行时 ----
# 某台想跟 accelerator_type 的自动判定不一样时用它(优先级更高):
#   #cpu-009 ansible_host=10.14.64.9 calico_pool=gpu     # 没插卡但想用 GPU 网段
#   #gpu-002 ansible_host=10.14.64.12 accelerator_type=nvidia calico_pool=cpu  # 有卡但走 CPU 网段
# 写 calico_pool=gpu 就行, 不用自己拼 hardware=gpu 那种键值对里套键值对的格式。
#
# ⚠ 标签只在【节点首次加入】时打(kube-add-node/-master 的 when 里有 not kubelet_conf.stat.exists)。
#   已加入的存量节点事后开双池, 不会自动补标签 —— 无标签节点两个池都匹配不上、拿不到地址块,
#   需手工补: kubectl label node <名> hardware=gpu --overwrite  (然后 kubectl get node -L hardware 核对)
#
# 全是 GPU 机器时不必每行都写, 可建 inventory/group_vars/<组名>.yaml 统一设:
#   # inventory/group_vars/gpu_nodes.yaml
#   accelerator_type: nvidia
# ⚠ 别写成本文件的 [组名:vars] —— inventory 文件里的组变量优先级【低于】group_vars/ 目录,
#   会被 group_vars/all/env.yaml 静默盖掉(与下方 [all:vars] 那条警告同一个坑)。
[k8s_master]
# 控制平面(建议奇数台); 多 master 需配 lbvip + 跑 LB(见 [k8slb])
#cpu-001
[k8s_node]
# worker 节点
#cpu-005
#cpu-008

[etcd]
# 外置 etcd(建议 3/5 台奇数; 可与 master 共机)
#cpu-001


[k8slb]
# haproxy+keepalived LB(多 master 才需要; 常与 master 共机)
# 只列主机名; VIP 网卡自动按 ansible_host 探测, 无需 host_ip
#cpu-001

[harbor]
# Harbor 节点(在线从公共 mirror 拉镜像时可不部署)
#172.171.1.217

[docker]
# 装 docker 的节点(本项目里 docker 仅给 Harbor 用; k8s 节点跑 containerd 直连,不用 docker)。
# 按行内 accelerator_type 区分:
#   accelerator_type=nvidia -> docker + nvidia-container-toolkit(daemon 默认 runtime=nvidia)
#   不设                     -> 普通 docker
# ⚠️ docker 侧【只支持 nvidia】; dcu/npu(华为昇腾)只在 containerd 生效,别往这组写 dcu/npu。
#cpu-008
#a800-node30 accelerator_type=nvidia
[cri_docker_nodes]
# cri-dockerd 已弃用,留空

# ---- 扩缩容临时组(平时留空; 加/删时才填,只列主机名) ----
# 注: 加 master/worker 直接进 [k8s_master]/[k8s_node] + --limit 即可, 无需 master_to_add
[node_to_delete]
[etcd_to_add]
[etcd_to_delete]
[master_to_delete]

# ---- GPU:有算力节点时用。[gpu]=打"有GPU"标签(角色自动判 gpu); [gpu_driver]=装驱动/升内核 ----
# ⚠ GPU 节点只跑 os-init, 绝不进 [gpu_driver]。机器本体仍写在上面 [cluster](带 osinit_su)。
[gpu]
#gpu-su1-001
#[gpu_driver]
#gpu-su1-001

# ---- 内网 NTP 服务器(可选; 不需要就【整组留空】, 全集群沿用原来的 chrony_ip 客户端行为)----
# 填了才生效: 该机 chrony 变成对下服务的 NTP server, 其余节点自动改指向它(不用再改 chrony_ip)。
# 只列主机名(机器本体仍写在上面 [cluster])。配套变量见 env.yaml 的 chrony_allow_networks。
# ⚠ 填了本组就必须配 chrony_allow_networks, 否则 role 内 assert 会拦住(chrony 默认拒绝所有请求)。
[chronyserver]
#cpu-001

# os-init / os-check 直接跑 [cluster] 组(= 全部机器), 不再用单独的别名组。

[cluster:vars]
# 主机名以清单里写的名字为准; 别用 ip(会把 cpu-001 改成 CPU-111)。其他: keep / explicit
osinit_hostname_policy=inventory

[all:vars]
# 集群参数(is_offline / lbvip 等)统一在 group_vars/all/env.yaml 配。
# 连接身份(root 直连 / 普通用户+sudo)由 group_vars/all/connection.yaml 自动探测。
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
