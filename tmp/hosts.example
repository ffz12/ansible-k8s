# inventory 主机清单模板 —— 复制为 inventory/hosts 并按实际填写(去掉行首 #)
# 约定: ansible_host 及自定义变量【只在 [cluster] 写一次】, 其余组只列主机名(同名=同一台)

[cluster]
# 所有节点; ansible_host 只在这里定义; 可带 ipmi_ip / storage_ip 等自定义变量
#cpu217 ansible_host=172.171.0.217
#cpu218 ansible_host=172.171.0.218
#cpu219 ansible_host=172.171.0.219
#node001 ansible_host=172.171.0.11

[containerd]
# 用 containerd 的节点(只列主机名); GPU 节点加 accelerator_type=nvidia/dcu/npu, 纯 CPU 不写
#cpu217
#cpu218
#cpu219
#node001

[k8s_master]
# 控制平面(建议奇数台); 多 master 需配 lbvip + 跑 LB(见 [k8slb])
#cpu217
#cpu218
#cpu219

[k8s_node]
# worker 节点
#node001

[etcd]
# 外置 etcd(建议 3/5 台奇数; 可与 master 共机)
#cpu217
#cpu218
#cpu219

[k8slb]
# haproxy+keepalived LB(多 master 才需要; 常与 master 共机)
# 只列主机名; VIP 网卡自动按 ansible_host 探测, 无需 host_ip
#cpu217
#cpu218
#cpu219

[harbor]
# Harbor 节点(在线从公共 mirror 拉镜像时可不部署)
#cpu217

[docker]
# 装 docker 的节点(给 Harbor/cri-docker 用); 与 containerd 一致按行内 accelerator_type 区分:
#   nvidia -> 装 nvidia-container-toolkit; 不设 -> 普通 docker
#cpu217
#a800-node30 accelerator_type=nvidia
[cri_docker_nodes]
# cri-dockerd 已弃用,留空

# ---- 扩缩容临时组(平时留空; 加/删时才填,只列主机名) ----
# 注: 加 master/worker 直接进 [k8s_master]/[k8s_node] + --limit 即可, 无需 master_to_add
[node_to_delete]
[etcd_to_add]
[etcd_to_delete]
[master_to_delete]

[all:vars]
# 时钟同步 NTP 源
#chrony_ip=10.5.0.6
# k8slb 虚拟 IP(VIP); 单 master 可不设(不配 LB), 多 master 高可用才需要
#lbvip=172.171.0.250
# VIP 掩码,按实际网段改(如 24)
#vip_prefix=24
# CNI 插件: calico(默认) / flannel / cilium
#kube_network_plugin=calico
# 离线部署置 true(在线留默认 false 或不设)
#is_offline=false

# 连接方式:
# 【还没配 root 免密】用普通用户 + sudo:
#ansible_user=user
#ansible_ssh_pass=Admin@123+
#ansible_become=true
#ansible_become_method=sudo
#ansible_become_pass=Admin@123+
#ansible_python_interpreter=/usr/bin/python3
#ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
# 【已提供 root 且免密】上面 ssh_pass / become* 那几行可省
