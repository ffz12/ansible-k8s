# inventory 主机清单模板: 复制为 inventory/hosts 后按实际填写(去掉行首 #)
# 机器只在 [cluster] 写一次(带 ansible_host 等变量), 其它组只列主机名。
# 各组用途、机器行可用变量、注意事项见 docs/主机清单说明.md

[cluster]
#cpu-001 ansible_host=192.168.1.111 kube_node_ip=192.168.1.111 accelerator_type=cpu
#gpu-001 ansible_host=192.168.1.121 kube_node_ip=192.168.1.121 accelerator_type=nvidia

[init]
#cpu-001

# ---- 挂盘 ----
[nvme_lvm]
#gpu-001

[nvme_single]
#cpu-001 device_path=/dev/nvme0n1 data_disks="/dev/nvme1n1:/data"

# ---- 运行时 / Harbor ----
[containerd]
#cpu-001

[docker]
#cpu-001

[harbor]
#cpu-001

[cri_docker_nodes]

# ---- Kubernetes ----
[k8slb]
#cpu-001

[k8s_master]
#cpu-001

[k8s_node]
#gpu-001

[etcd]
#cpu-001

# ---- 扩缩容临时组(平时留空) ----
[node_to_delete]
[etcd_to_add]
[etcd_to_delete]
[master_to_delete]

# ---- 可选 ----
[gpu]
#gpu-001
#[gpu_driver]

[chronyserver]
#cpu-001

[ceph]

[cluster:vars]
osinit_hostname_policy=inventory

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
