# inventory 主机清单模板: 复制为 inventory/hosts 后按实际填写(去掉行首 #)
# 机器只在 [cluster] 写一次(带 ansible_host 等变量), 其它组只列主机名。
# 各组用途、机器行可用变量、注意事项见 docs/主机清单说明.md

[cluster]
# accelerator_type: GPU 机必须写 nvidia/dcu/npu(不写按 CPU 机装, 不装 GPU 运行时);
#   CPU 机写 cpu 才会打 cpu_node=true 标签, 不写也按 CPU 机装, 只是不打标签
# 有 RDMA(Mellanox)网卡的机器写 has_rdma=true, 会打 rdma=true 标签给 rdma device plugin 用
# 没外网的机器按行配 DNS: init_config_dns=true dns=10.14.73.1
#cpu-001 ansible_host=192.168.1.111 kube_node_ip=192.168.1.111 accelerator_type=cpu
#gpu-001 ansible_host=192.168.1.121 kube_node_ip=192.168.1.121 accelerator_type=nvidia has_rdma=true

[init]
# 只放这次要初始化的机器, 已交付的老机器别放
#cpu-001

# ---- 挂盘(旧组名 nvme_lvm / nvme_single 仍兼容) ----
[disk_lvm]
# 会清盘! 先 --check 看选中了哪几块
#gpu-001

[disk_direct]
#cpu-001 device_path=/dev/nvme0n1 data_disks="/dev/nvme1n1:/data"

# ---- 运行时 / Harbor ----
[containerd]
# k8s 节点都放这里; 支持 nvidia / dcu / npu
#cpu-001

[docker]
# 只给 Harbor 用; 只支持 nvidia, dcu/npu 机别放这里
#cpu-001

[harbor]
# 1 台单节点, 2 台双主(互相复制, 不用 VIP); 加第二台时有数据的写第一个
#cpu-001

[cri_docker_nodes]

# ---- Kubernetes ----
[k8slb]
# 多 master 才需要
#cpu-001

[k8s_master]
# 建议奇数台; 多 master 要配 lbvip
#cpu-001

[k8s_node]
#gpu-001

[etcd]
# 建议 3 或 5 台
#cpu-001

# ---- 扩缩容临时组(平时留空) ----
[node_to_delete]
[etcd_to_add]
[etcd_to_delete]
# 只管 LB 层, 与删 k8s master 无关; 缩容 LB 时这一行不能删, 否则静默跳过
[master_to_delete]

# ---- 可选 ----
[gpu]
#gpu-001
#[gpu_driver]

[chronyserver]
# 留空 = 全集群直连 chrony_ip; 填 2 台以上为主备
#cpu-001

[ceph]

[cluster:vars]
# 主机名取清单里的名字, 别改成 ip
osinit_hostname_policy=inventory

[all:vars]
# 集群参数写 env.yaml, 别写这里(优先级低, 会被覆盖)
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
