# ============================================================================
#  env.yaml —— 部署新环境「需要改」的变量(其余默认见 defaults.yaml)
#  顺序: 连接 → 全局开关 → 基础设施(Harbor/路径/运行时/VIP) → 系统初始化调参
# ============================================================================

# ---- 连接身份(逻辑见 group_vars/all/connection.yaml) ----
connect_as: root                         # 默认 root 免密直连(本项目常态)。首次未免密: 改 sudo 填下面 bootstrap_*, 或临时 -e connect_as=auto 探测
# 下面 3 个仅 connect_as=sudo(或 auto 探测回退到 用户+sudo)时用到; root 全程免密可不填; 密码回退需控制机装 sshpass
#bootstrap_user: user
#bootstrap_ssh_pass: "改成该用户SSH密码"
#bootstrap_become_pass: "改成sudo密码(通常同上)"

# ---- 在线 / 离线(全局开关) ----
# false=在线(公网/镜像源); true=离线(init 改用本地 /opt/*-pkgs 源)。统一跑 init.yaml, 只改这里。
is_offline: false

# ---- 离线预取范围(学 kk: 声明一次架构+系统, prefetch-all.sh 自动读取, 不用每次手打 ARCH=/DISTRO=) ----
# 不填=all(双架构、全发行版, = 现状)。优先级: 环境变量 ARCH=/DISTRO= > 这里 > all。
#offline_arch: amd64                    # amd64 | arm64 | all —— 本套集群的架构
#offline_distros: [ubuntu, kylin]       # all 或列表, 只对 packages(系统依赖包)层生效; 用不到的发行版就不下

# ---- Harbor(域名/地址/账号) ----
harbor_instances:
  - { dns: "harbor.local.clusters", ip: "172.171.0.206" }
harbor_admin_username: admin
harbor_admin_password: Harbor12345      # 建议改
password: root123                        # harbor 数据库密码,建议改
# harbor 里存 k8s 镜像的项目名; 不填默认 kubernetes。镜像前缀 registry = <harbor_dns>/<harbor_project>
#harbor_project: kubernetes

# ---- 路径/目录(数据盘挂载点 / 安装位置) ----
container_base: "/var/lib/container"     # containerd/kubelet 数据盘主挂载点
data_root: /var/lib/docker               # docker 数据目录
harbor_copy_path: /data/harbor-install   # harbor 安装目录
data_volume: /data/harbor-data           # harbor 数据目录
nginx_dir: /data/nginx                   # nginx-ha 安装目录
keepalived_dir: /data/keepalived         # keepalived 安装目录

# ---- 容器运行时 + 镜像加速 ----
containerd_version: "1.7.32"             # 可选 "2.2.3"(config v3) / "1.7.32"(config v2)
runc_version: "1.1.12"
# docker 层(本项目 docker 仅给 Harbor 用; 版本供 docker_arch_map 拼包名 + 离线下载脚本)
docker_version: "29.4.2"                 # docker 静态二进制包版本
buildx_version: "0.32.1"                 # docker buildx 插件版本
compose_version: "2.32.4"                # docker compose 插件版本(仅离线下载脚本用; docker_arch_map 的 compose 文件名不带版本)
cri_dockerd_version: "0.3.16"            # cri-dockerd 版本(cri-dockerd 已弃用, 一般用不到)
# sandbox(pause)镜像 —— 显式写死, 对齐现网实际路径。
# 接管【已有集群】时必须写: 现网 pause 早已推在固定路径下, 派生值未必与之一致;
# 而 containerd 的 sandbox_image 一旦与现网不符, kube-init-master 预检会直接拦下。
# 换 k8s 版本或改 harbor 项目名时, 记得同步改这里(kubeadm config images list 可查 pause tag)。
# 不写(注释掉)则由 defaults.yaml 自动派生:
#   离线 <registry>/pause:<pause_image_version>, 在线 <kube_image_mirror>/pause:<pause_image_version>
#   (registry = <harbor_dns>/<harbor_project>; pause_image_version 按 k8s_version 从 k8s_compat 派生)
sandbox_image: harbor.local.clusters/kubernetes/pause:3.10.1
docker_mirrors:                          # 容器镜像加速(可选)
  - "https://docker.hlmirror.com"
  - "https://docker.1ms.run"
  - "https://docker.m.daocloud.io"
  - "https://proxy.1panel.live"

# ============================================================================
#  Kubernetes / CNI / 网络 / etcd / 下载源
# ============================================================================

# ---- K8s 版本 & CNI ----
k8s_version: "1.34.3"                    # 当前 1.34.3; 另一支持 1.28.8。切版本改这一处(配套组件自动派生)
kube_network_plugin: calico             # calico(manifest) / flannel(manifest) / cilium(helm)
# calico 封装: none(纯 BGP,性能最好,需节点二层互通) / crosssubnet(跨子网才 IPIP) / ipip / vxlan
calico_encapsulation: none
# Pod 带宽限速(kubernetes.io/{ingress,egress}-bandwidth 注解)。默认关。
# ⚠ 开之前必须确认各节点 /opt/cni/bin/bandwidth 存在 —— calico-cni 镜像【不含】该插件,
#   它属于上游 containernetworking/plugins。置 true 后 kube-common 会自动装该包;
#   若手工改了 conflist 却没装插件, 全节点 Pod 都建不了 sandbox:
#     plugin type="bandwidth" failed (add): failed to find plugin "bandwidth"
#calico_enable_bandwidth: false
#cni_plugins_version: "1.6.2"            # 上一项为 true 时才用到
# cilium 路由: tunnel(overlay,默认) / native(直接路由,同二层)
cilium_routing_mode: tunnel
cilium_tunnel_protocol: vxlan           # tunnel 模式下: vxlan / geneve
cilium_kube_proxy_replacement: false    # true=eBPF 替换 kube-proxy(需内核>=5.10)
enable_multus: false                     # 是否叠加 multus 多网卡

# ---- 组件版本(与 k8s 版本无关, 按各自兼容矩阵挑) ----
# ⚠ etcd_version 不在这里写 —— 它与 k8s 版本强配套, 由 defaults.yaml 的 k8s_compat 按
#   k8s_version 自动派生(值 = kubeadm config images list 给的 etcd tag 剥掉 -N 后缀)。
#   下载脚本也用 kubeadm 校准同一个值, 两边才对得上; 在这里手写会盖掉派生值, 导致
#   下载落 etcd/v3.6.4/ 而部署去找 etcd/v3.6.8/ 报「Could not find」。
#   确需钉死某版本时才取消下行注释(并自行保证与 k8s 版本兼容):
#etcd_version: "3.6.4"
calico_version: "3.31.3"
flannel_version: "0.26.7"
flannel_cni_version: "1.6.2-flannel1"    # flannel-cni-plugin 镜像 tag(拼进 flannel_images.flannel_cni)
cilium_version: "1.16.5"
helm_version: "3.18.5"                    # 不带 v; 脚本/模板会自动拼 helm-v{{helm_version}}
multus_cni_version: "4.2.4"
nodelocaldns_version: "1.26.4"           # NodeLocal DNSCache(k8s-dns-node-cache); registry.k8s.io/dns 上游 tag
# 是否启用 NodeLocal DNSCache(每节点本地 DNS 缓存, 查询链: Pod -> 169.254.25.10 -> CoreDNS)。
# true = 装机时随 CNI 之后自动部署 DaemonSet, 并把 kubelet 的 clusterDNS 指向它(与 kk 同款做法);
#        worker 由 kubeadm join 拉 kubelet-config ConfigMap 自动继承, 无需单独配。
# 不填/false = 不装, Pod 直连 coredns ClusterIP。
# 单绑 link-local 形态, iptables / ipvs 两种 kube-proxy 模式都适用。
#enable_nodelocaldns: true
#nodelocaldns_ip: "169.254.25.10"        # 默认值; 改了要与各节点 kubelet clusterDNS 一致
#nodelocaldns_coredns_svc: coredns       # 上游 CoreDNS Service 名(kk=coredns; kubeadm 原生=kube-dns)

# ---- 网络 ----
pod_subnet: 10.244.0.0/12
service_subnet: 10.96.0.0/12
apiserver_port: 6443                     # apiserver 本地监听端口(LB 后端)
apiserver_lb_port: 8443                  # 经 VIP 访问的端口(kubeadm controlPlaneEndpoint + LB 前端)
kube_criSocket: unix:///run/containerd/containerd.sock   # 默认 containerd; cri-dockerd 用 unix:///var/run/cri-dockerd.sock
#kube_cp_endpoint_ip: 172.171.0.x        # 加 worker 时 controlPlaneEndpoint 域名(如 kk 的 lb.kubesphere.local)在新节点上解析到的地址; 默认取 lbvip 或首 master IP
dns_domain: cluster.local                # 集群内 DNS 域名(几乎不用改)
kube_proxy_mode: ipvs                    # ipvs(默认,需内核 ip_vs 模块) / iptables(无 ipvs 时退回)

# ---- kubelet 调优 ----
kubelet_cpu_manager_policy: "none"       # none(通用) / static(CPU 绑核, 仅 AI 物理机)
kubelet_cpu_align_by_socket: false       # 仅 static 且 sockets<=NUMA 节点数时才 true(否则 kubelet 起不来)
kubelet_max_pods: 110                    # AI 大节点可调大(注意 pod CIDR 每节点容量)
kubelet_kube_reserved_cpu: "200m"
kubelet_kube_reserved_mem: "512Mi"
kubelet_system_reserved_cpu: "200m"
kubelet_system_reserved_mem: "256Mi"
# 驱逐策略(内存阈值/宽限; 磁盘/pid 相关阈值在 kubeadm-config.yaml.j2 里固定)
kubelet_eviction_hard_mem: "5%"          # 硬驱逐: 低于此立即驱逐 Pod(无宽限)
kubelet_eviction_soft_mem: "10%"         # 软驱逐: 低于此且持续超宽限期才驱逐
kubelet_eviction_soft_grace: "1m30s"     # 软驱逐宽限期
kubelet_eviction_max_pod_grace: 120      # 驱逐时给 Pod 的最大优雅退出秒数
kubelet_eviction_pressure_transition: "30s"  # 退出驱逐压力状态的最短停留(防抖)
kubelet_pod_pids_limit: 50000            # 单 Pod 最大进程数(防 fork 炸弹); -1 不限。AI 训练/多进程负载易撞 1w 上限, 故给 5w
kubelet_container_log_max_size: "5Mi"    # 单容器日志文件上限
kubelet_container_log_max_files: 3       # 容器日志保留文件数
kubelet_shutdown_grace: "30s"            # 节点关机时给普通 Pod 的优雅退出时间
kubelet_shutdown_grace_critical: "10s"   # 其中留给关键 Pod 的部分
#kubelet_security_enhancement: false      # true=开 CIS 安全加固(关只读端口10255/protectKernelDefaults/TLS套件等)

# ---- etcd ----
etcd_install_dir: "/opt/etcd"            # 二进制目录
etcd_data_dir: "/var/lib/etcd"           # 数据目录
etcd_cert_expiry: "36500"                # 证书有效期(天)
# ⚠ 上面只管 etcd 自身证书。k8s 那边分两套, 都已默认 100 年, 一般不用动:
#   · 控制面证书(apiserver/admin.conf 等): kubeadm 直签, 由 kubeadm-config 的
#     caCertificateValidityPeriod / certificateValidityPeriod 控制(876000h)
#   · kubelet 的 client/serving 证书: 走 CSR, 由 controller-manager 的
#     --cluster-signing-duration 控制 —— 即下面这个变量(不设默认才 8760h=1y, 会与上面不一致)
kube_signing_duration: "876000h"         # =100y, 与上面控制面证书对齐; 改小需同步考虑证书轮换与审批
etcd_cluster_token: "prod-etcd-cluster-01"
#etcd_enable_metrics: true               # 是否暴露 etcd metrics 端点(监控用; 有安全顾虑可关)
etcd_config:
  quota_backend_bytes: 8589934592        # 8G
  auto_compaction_retention: "1h"
  auto_compaction_mode: periodic
  heartbeat_interval: 500
  election_timeout: 5000
  log_level: info

# ---- 在线下载源(离线 is_offline=true 时不用管) ----
# 默认值都在 defaults.yaml(均为「多源失败自动切换」的复数列表), 想换源才在这里【给完整列表】覆盖同名项。
# ⚠ 用复数名(k8s_bin_mirrors / gh_proxies / ...); 早期的单数名(k8s_bin_mirror / gh_proxy)已废弃, 代码不再读, 别再用。
#k8s_bin_mirrors:
#  - "https://files.m.daocloud.io/dl.k8s.io/release"
#  - "https://dl.k8s.io/release"
#etcd_bin_mirrors:
#  - "https://mirrors.huaweicloud.com/etcd"
#  - "https://files.m.daocloud.io/github.com/etcd-io/etcd/releases/download"
#gh_proxies:                              # github 代理(containerd/runc/crictl 的 *_bin_mirrors 由它派生)
#  - "https://ghfast.top/https://github.com"
#  - "https://ghproxy.net/https://github.com"

# ---- 高可用入口 VIP(跑 LB 才需要) ----
# 跑 LB([k8slb] 组)才取消下行注释填 VIP。不填=单 master, apiserver 入口自动取首 master:apiserver_port。
# 空串 lbvip: "" 现在也能正确当作"未设置"(由 defaults.yaml 的 has_lbvip 统一判定: 已定义且 trim 非空),
# 但仍建议直接注释掉本行, 语义更清楚。
# lbvip: 172.171.0.250
vip_prefix: 22                           # VIP 掩码位数(仅配了 lbvip 时生效)

# ============================================================================
#  系统初始化调参(init / os-init / os-check)
#  os* 系是站点预设, 覆盖角色默认(见 roles/*/defaults); 当前为「青岛联通交付」取值, 换项目按需改。
# ============================================================================

# ---- 时间同步 & 时区 ----
# NTP 源, 内网无外网改内网 IP。init 与 os-init 共用此变量(osinit_ntp_servers 默认取它)。
chrony_ip: ntp1.aliyun.com
# 要配多源冗余时才显式覆盖(否则默认取上面 chrony_ip):
#   osinit_ntp_servers: [10.82.4.1, 10.82.4.2]
# 时间没同步上不中断后续步骤(降级为 ⚠ 告警); os-check 侧仍判 FAIL, 交付报告会带出来。
# 找到可用内网 NTP 后改 chrony_ip 重跑: --tags time
osinit_fail_on_unsynced: false
# ⚠【偏离交付标准】标准要求 UTC, 本项目用 Asia/Shanghai(只影响显示, 不影响对时精度)。
#   下面两值必须一致(不一致 os-check 会误报 FAIL); 交付材料里应作为偏离项列出或与甲方确认。
osinit_timezone: Asia/Shanghai
oscheck_expect_timezone: Asia/Shanghai

# ---- DNS(Debian 系初始化, 默认不接管) ----
# init_config_dns=false(默认): 不碰系统原有 DNS, 下面 dns/domains 不生效。
# 要 ansible 接管(写 systemd-resolved)时置 true, 并填好 dns/domains。
init_config_dns: false
dns:
- 114.114.114.114
- 223.5.5.5
domains: "local.clusters"

# ---- 主机名 / hosts ----
# 不往 /etc/hosts 写全集群映射(本项目靠 IP 互访)。
# ⚠ 置 false 会把以前写进去的那个块【清掉】, 不是留着不管。
osinit_write_cluster_hosts: false

# ---- 统一登录账号 ----
osacct_user: wwxq                        # 账号名; 角色默认中性 osadmin, 青岛交付要求 wwxq
osacct_user_sudo_nopasswd: true          # sudo 免密(本项目运维习惯, 交付标准无要求)
# 删除除统一账号 / root 外的一般用户(uid>=1000)。
# ⚠【不可逆】state=absent + remove=yes, 家目录一起删。开之前确认 root 或统一账号能登进去。
#    想先看会删谁不真删: 保持 false 跑一遍看"多余一般用户盘点"那步输出。
osacct_remove_extra_users: true

# ---- 统一登录密码 ----
# 就写这里(本文件已 gitignore 不入库), 取消注释填实际密码, 直接跑 os-init.yaml, 不用 export:
#osacct_user_password: '实际密码'
# 替代: export OSACCT_USER_PASSWORD='实际密码'(别用 sudo 会清环境变量, 要 sudo -E)。
# ⚠ 只写一处: env.yaml 优先级 > 角色默认, 两处都写时环境变量永不生效。
# root 密码默认同统一密码; 要单独设: osacct_root_password: '另一个密码'
