# ============================================================================
#  env.yaml —— 部署新环境「需要改」的变量(其余默认见 defaults.yaml)
#  顺序: 连接 → 全局开关 → 基础设施(Harbor/路径/运行时/VIP) → 系统初始化调参
# ============================================================================

# ---- 连接身份(逻辑见 group_vars/all/connection.yaml) ----
connect_as: root                         # 默认 root 免密直连(本项目常态)。首次未免密: 改 sudo 填下面 bootstrap_*, 或临时 -e connect_as=auto 探测
# 下面 3 个仅 connect_as=sudo(或 auto 探测回退到 用户+sudo)时用到; root 全程免密可不填; 密码回退需控制机装 sshpass
#bootstrap_user: user
#bootstrap_ssh_pass: "改成该用户SSH密码"
#bootstrap_become_pass: "改成sudo密码(通常同上)"

# ---- 在线 / 离线(全局开关) ----
# false=在线(公网/镜像源); true=离线(init 改用本地 /opt/*-pkgs 源)。统一跑 init.yaml, 只改这里。
is_offline: false

# ---- Harbor(域名/地址/账号) ----
harbor_instances:
  - { dns: "harbor.local.clusters", ip: "172.171.0.206" }

# 双主: inventory [harbor] 组填 2 台即开启(两台各存一份, 互相复制, 不用 VIP)。
#   上面 ip 填主节点; 主故障时改成另一台, 再跑 ansible-playbook playbook/harbor-trust.yaml。

# ---- 路径/目录(数据盘挂载点 / 安装位置) ----

container_base: "/data"     # containerd/kubelet  数据盘主挂载点
#containerd_root: /data/containerd       # 不写 = <container_base>/containerd; 可单独放到另一块数据盘
data_root: /data/docker                  # docker 数据目录
harbor_copy_path: /data/harbor-install   # harbor 安装目录
data_volume: /data/harbor-data           # harbor 数据目录
etcd_install_dir: "/opt/etcd"            # etcd二进制目录
etcd_data_dir: "/var/lib/etcd"           # etcd数据目录

# ---- apt 代理(playbook/apt-proxy.yaml 用; 机房有 squid 之类才需要) ----
# 站点专属值, 写在这里而不是改 playbook —— 本文件生成的 env.yaml 在 .gitignore 里,
#apt_proxy_url: "http://10.14.73.20:3128"


# ---- 版本信息------

containerd_version: "2.3.5"              
runc_version: "1.5.1"
k8s_version: "1.35.8"
calico_version: "3.32.2"
helm_version: "3.18.5"                    # 不带 v; 脚本/模板会自动拼 helm-v{{helm_version}}
multus_cni_version: "4.2.4"
nodelocaldns_version: "1.26.4"           # NodeLocal DNSCache(k8s-dns-node-cache); registry.k8s.io/dns 上游 tag

#--- cni插件配置-----
# calico(manifest) / flannel(manifest) / cilium(helm)
kube_network_plugin: calico            
# calico 封装: ipip(默认,不要求二层互通) / crosssubnet(同子网走 BGP,跨子网才 IPIP) /
#              vxlan(IPIP 被中间设备挡掉时用) / none(纯 BGP,性能最好但【要求节点二层互通】)
calico_encapsulation: ipip

# calico-node 使用管理网卡名，业务网卡名
#calico_ip_autodetection_method: interface=bond0

# pod网段和svc网段
pod_subnet: 10.233.64.0/18              # 1.6 万个 Pod 地址; 开双池必须改, 见下面【第 0 步】
service_subnet: 10.233.0.0/18           # 1.6 万个 Service; 与 pod_subnet 不重叠(同 kk 默认)

# ---- Calico 双 IPPool(GPU/CPU 分 Pod 网段, 可选, 默认关) ----
# 下面两池已经按上面默认的 pod_subnet 10.233.64.0/18 算好, 直接取消注释即可(只删行首一个 #):
#   pod_subnet   10.233.64.0/18   = 10.233.64.0 - 10.233.127.255   ← 必须覆盖两池
#   gpu 池       10.233.64.0/19   = 10.233.64.0 - 10.233.95.255
#   cpu 池       10.233.96.0/20   = 10.233.96.0 - 10.233.111.255   (112.0-127.255 留空备用)
#   service_subnet 10.233.0.0/18  = 10.233.0.0 - 10.233.63.255     ← 不能与两池重叠
# ⚠ 改了 pod_subnet 就要重新算两池, 让它们落在 pod_subnet 里面 —— 两池不在 pod_subnet 内时
#   calico.yaml 的预检会拦下(pod_subnet 建完集群不可改, 所以必须装机前算对)。
#   自己规划时照上面四行把起止地址列出来核对, 算法见 docs/部署说明.md 十三.1。
#calico_dual_ippool_enabled: true
#calico_gpu_pool_cidr: "10.233.64.0/19"   # 必填(上一项为 true 时)
#calico_cpu_pool_cidr: "10.233.96.0/20"   # 必填(上一项为 true 时)
#calico_gpu_pool_blockSize: 28            # 每块 16 个地址; 按 110 Pod 每节点要 7 块
#calico_cpu_pool_blockSize: 26            # 每块 64 个地址; 按 110 Pod 每节点要 2 块

# kube-proxy 模式：ipvs/nftables(警告：ipvs 上游已弃用, k8s 1.40 默认禁用、k8s 1.43 移除)。
kube_proxy_mode: ipvs

# ---- device plugin(GPU / RDMA 资源上报, playbook/device-plugin.yaml) ----
# 装哪些按 inventory 的 accelerator_type 自动判断(有 nvidia 节点就装 nvidia 插件), 这里不用填。
# rdma 是网卡能力不在 accelerator_type 里, 默认装; 没有 Mellanox 网卡的站点置 false。
device_plugin_rdma: true
# ⚠ 必须按实际网卡核对: lspci -nn | grep -i mellanox, 取 [15b3:xxxx] 里的 xxxx。
#   填错的症状是 DaemonSet 正常起来但 rdma 资源容量是 0。
rdma_device_ids: ["101b", "a2dc"]
#rdma_hca_max: 1000                      # 一块 HCA 最多给多少个 Pod 用(shared 模式, 不是独占)
# 下面两项与现网一致(默认 true)。装了 nvidia-container-toolkit 通常不需要, 确认不需要再关:
#nvidia_device_plugin_privileged: false
#nvidia_device_plugin_mount_libnvidia_ml: false


# ---- apiserver 入口 / 高可用 VIP(这几项一体) ----
apiserver_port: 6443                     # apiserver 本地监听端口(LB 后端)
apiserver_lb_port: 8443                  # 经 VIP 访问的端口(kubeadm controlPlaneEndpoint + LB 前端; 仅跑 LB 时用到)
#lbvip: 172.171.0.250                     # 跑 LB([k8slb] 组)填 VIP，与业务网卡同网段
#vip_prefix: 22                           # VIP 掩码位数(仅配了 lbvip 时生效)也业务子网同掩码
cp_endpoint_domain: lb.local.clusters    # apiserver域名访问 ----


# ---- kubelet 调优 ----
# 驱逐策略(内存阈值/宽限; 磁盘/pid 相关阈值在 kubeadm-config.yaml.j2 里固定)
kubelet_eviction_hard_mem: "5%"          # 硬驱逐: 低于此立即驱逐 Pod(无宽限)， 真实物理机内存写10Gi
kubelet_eviction_soft_mem: "10%"         # 软驱逐: 低于此且持续超宽限期才驱逐， 真实物理机内存写20Gi



# ---- 时间同步 ----
chrony_ip: ntp1.aliyun.com                 # 上游 NTP; 机房不能出网就填内网 NTP 的 IP
# ---- 内网 NTP server(可选)----
# 开关是 inventory 的 [chronyserver] 组:
#   留空      所有节点直接同步 chrony_ip
#   填 1 台   它同步 chrony_ip 并对内服务, 其余节点自动改指向它
#   填 2 台+  主备, 客户端自动选(原理与排查见 docs/部署说明.md「时间同步」)
# 客户端放行: all = 不限网段; server 暴露在外网/他租户网络时才收紧成具体网段, 如 172.171.0.0/16
chrony_allow_networks:
  - all
chrony_cloud_metadata_ntp: true            # 云厂商元数据 NTP(169.254.169.254); 裸金属连不上, 不影响其它源
