# ============================================================================
#  env.yaml —— 部署新环境「需要改」的变量(其余默认见 defaults.yaml)
# ============================================================================

# ---- 连接身份(逻辑见 group_vars/all/connection.yaml) ----
connect_as: auto                         # auto=探测(root 免密→root, 否则 用户+sudo) / root / sudo
# 下面 3 个仅「回退到 用户+sudo」时用到(root 全程免密可不填); 密码回退需控制机装 sshpass
#bootstrap_user: user                    # 回退用的普通用户(sudo 提权)
#bootstrap_ssh_pass: "改成该用户SSH密码"
#bootstrap_become_pass: "改成sudo密码(通常同上)"

# ---- Harbor(域名/地址/账号) ----
harbor_instances:
  - { dns: "harbor.local.clusters", ip: "172.171.0.206" }
harbor_admin_username: admin
harbor_admin_password: Harbor12345      # 建议改
password: root123                        # harbor 数据库密码,建议改

# ---- 路径/目录(数据盘挂载点 / 安装位置) ----
container_base: "/var/lib/container"     # containerd/kubelet 数据盘主挂载点
data_root: /var/lib/docker               # docker 数据目录
harbor_copy_path: /data/harbor-install   # harbor 安装目录
data_volume: /data/harbor-data           # harbor 数据目录
nginx_dir: /data/nginx                   # nginx-ha 安装目录
keepalived_dir: /data/keepalived         # keepalived 安装目录

# ---- 高可用入口 VIP(跑 LB 才需要) & 时钟同步 ----
# 不跑 LB(inventory 无 [k8slb])时 lbvip 保持注释即可; 跑 LB 才取消下一行注释填 VIP。
# ⚠ 别写成 lbvip: "" —— 空串也算「已定义」, 可能触发 LB 逻辑。
# lbvip: 172.171.0.250
vip_prefix: 22                           # VIP 掩码位数(仅配了 lbvip 时生效), 按实际网段改
# 时钟同步 NTP 源; 内网无外网就改成内网 NTP 服务器 IP。
# init 角色和 qdlt-init 角色【共用这一个变量】(qdlt_ntp_servers 默认就取它), 改这里一处即可。
chrony_ip: ntp1.aliyun.com

# ---- 容器运行时 ----
containerd_version: "1.7.32"             # 可选 "2.2.3"(config v3) / "1.7.32"(config v2)
runc_version: "1.1.12"
# containerd sandbox(pause)镜像; 换 k8s 版本要跟着改(kubeadm config images list 查)
sandbox_image: harbor.local.clusters/kubernetes/kubernetes/pause:3.10.1

# ---- 容器镜像加速(可选) ----
docker_mirrors:
  - "https://docker.hlmirror.com"
  - "https://docker.1ms.run"
  - "https://docker.m.daocloud.io"
  - "https://proxy.1panel.live"

# ---- DNS(Debian 系初始化用) ----
dns:
- 114.114.114.114
- 223.5.5.5
domains: "local.clusters"

# ============================================================================
#  青岛联通项目 (qdlt-init / qdlt-check) —— 本项目对交付标准的偏离与实际取值
#  角色默认值见 playbook/roles/qdlt-init/defaults/main.yaml, 此处覆盖。
# ============================================================================

# ⚠【已知偏离交付标准】交付标准第 3 页要求「统一使用 UTC 时区」,
#   本项目按实际需要改用 Asia/Shanghai。交付材料中应作为偏离项列出或事先与甲方确认。
#   时区只影响显示, 不影响对时精度与跨节点时间差(交付标准要求 <15 秒)。
qdlt_timezone: Asia/Shanghai

# NTP 源【复用上面的 chrony_ip】(init 角色和 qdlt-init 角色共用一处), 所以这里
# 不再单独写 qdlt_ntp_servers —— 换 NTP 源只改上面那行 chrony_ip 就够了。
# 机房有内网 NTP 就把 chrony_ip 改成内网地址(强烈推荐, 走公网大概率同步不上)。
# 现象: timedatectl 显示 "System clock synchronized: no" 就是一个源都没通,
#       用 chronyc sources -v 确认(全是 ^? 即不可达)。
# 只有要配【多个源做冗余】时才在这里显式覆盖(显式值优先, 会盖掉 chrony_ip):
#   qdlt_ntp_servers: [10.82.4.1, 10.82.4.2]

# 时间没同步上【不中断后续步骤】。
# 原因: 青岛现网这 6 台锁不上外部 NTP 源(公网 udp123 不通), 但节点之间时间实测只差
#   1 秒, 交付标准要求的是「集群最大时间差 <15 秒」, 这一条本来就满足。为这个把
#   GRUB/账号/CPU/swap 十来个步骤全卡住不值得。核对命令:
#     ansible qdlt -m shell -a 'date -u +%FT%T'
# ⚠ 它仍然【不符合交付标准】对时的要求, 只是降级为告警:
#   - qdlt-init 会打一条醒目的 ⚠ 告警(不中断), 说明是遗留项
#   - qdlt-check 侧【照旧判 FAIL】, 交付报告里会带出来, 不会被悄悄放过
#   找到可用的内网 NTP 后, 改上面的 chrony_ip 再重跑: --tags time
qdlt_fail_on_unsynced: false

# 体检(qdlt-check)的时区期望值必须与上面一致, 否则会误报 FAIL
qdlt_expect_timezone: Asia/Shanghai

# ---- 统一登录账号 wwxq 的 sudo 与多余账号清理 ----
# wwxq 的 sudo 免密(sudo -i 不再要求输密码)。交付标准没要求, 是本项目运维习惯。
qdlt_user_sudo_nopasswd: true

# 删除除 wwxq / root 之外的一般用户(uid>=1000)。
# ⚠【不可逆】: user state=absent + remove=yes, 家目录一起删。
#   现网这 6 台上就是镜像自带的 ubuntu 账号, 交付标准要求"系统上不存在其他一般用户"。
#   开之前先确认 root 免密或 wwxq 至少有一条能登进去, 别把自己关在门外。
#   只想先看会删哪些不真删: 保持 false 跑一遍看"多余一般用户盘点"那步的输出。
qdlt_remove_extra_users: true

# 不往 /etc/hosts 写全集群 IP-主机名 映射。交付标准无此要求, 本项目也不靠主机名
# 互访(inventory 里直接写 IP), 写进去只会多一份没人维护、改 IP 后还会带偏的旧记录。
# ⚠ 置 false 后 hostname.yaml 会把以前写进去的那个块【清掉】, 不是留着不管。
qdlt_write_cluster_hosts: false

# ---- 统一登录密码(交付标准: 系统登录账户使用统一账密) ----
# 就写在这里, 和上面的 harbor_admin_password / bootstrap_ssh_pass 放在一处 ——
# 本文件已被 .gitignore 忽略(init.sh 从 tmp/env.yaml.example 生成), 不会入库。
# 取消注释并填上实际密码, 然后直接跑, 不需要任何 export:
#   ansible-playbook playbook/qdlt-init.yaml
#qdlt_user_password: '实际密码'
#
# ⚠ 一个仓库只用一种放法, 别两处都写 —— 优先级 env.yaml(group_vars) > 角色默认值,
#   两处都有时环境变量那条【永远不生效】, 改了环境变量却不见效会查很久。
# 不想落文件时的替代方案(角色默认值就是它, 本行注释掉即生效):
#   export QDLT_USER_PASSWORD='实际密码'      # 注意别加 sudo, 它会清环境变量; 要用 sudo -E
# root 密码默认跟统一密码一致; 要单独设另一个: qdlt_root_password: '另一个密码'
