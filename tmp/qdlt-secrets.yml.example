# ============================================================================
#  青岛联通项目敏感变量模板
#
#  用法:
#    cp tmp/qdlt-secrets.yml.example inventory/qdlt-secrets.yml
#    vim inventory/qdlt-secrets.yml            # 填真实密码
#    ansible-vault encrypt inventory/qdlt-secrets.yml
#    ansible-playbook playbook/qdlt-init.yaml -e @inventory/qdlt-secrets.yml --ask-vault-pass
#
#  ⚠ inventory/qdlt-secrets.yml 必须加进 .gitignore, 不得明文入库。
# ============================================================================

# 交付标准要求的统一登录账号密码(用户名固定为 wwxq)
qdlt_user_password: "在此填写统一登录密码"

# 首次进场时厂商给的初始账号(用于 ansible 连接), 见 group_vars/all/connection.yaml
#bootstrap_user: ubuntu
#bootstrap_ssh_pass: "厂商初始密码"
#bootstrap_become_pass: "sudo 密码, 通常同上"
