[Unit]
# 由 Ansible qdlt-init 角色生成 —— 青岛联通交付标准: 所有 PCIe 设备 ACSCtl 关闭
#
# ACSCtl 是 PCI 配置空间里的寄存器, 每次重启都会被 BIOS/固件重新置位,
# 所以必须开机自动重跑一次, 否则只有当次生效。
Description=Disable PCIe ACSCtl on all devices (QDLT delivery standard)
# 要等 PCI 设备枚举完成; sysinit.target 之后足够
After=sysinit.target
# GPU 相关服务(fabricmanager/persistenced)应在 ACS 关闭之后再起,
# 否则 P2P 拓扑可能按 ACS 开启的状态初始化。
Before=nvidia-fabricmanager.service nvidia-persistenced.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ qdlt_acs_script_path }} apply
# 个别设备被固件锁定写不进去时脚本返回 3; 不因此让整个开机流程报红。
SuccessExitStatus=0 3

[Install]
WantedBy=multi-user.target
