# /etc/sysctl.d/99-node-tuning.conf —— 由 ansible 下发, 请勿手改
# 大规模容器/K8s 场景的内核参数补充调优(可选, 按需在 env.yaml 开启)。
#
# 为什么单独放 sysctl.d 而不改 /etc/sysctl.conf:
#   1) 是【站点级可选项】, 只在需要的站点启用(node_tuning_sysctl=true),
#      不影响其它站点与现网 111 节点集群;
#   2) 数字越大的文件后加载、优先级越高, 99- 确保覆盖 /etc/sysctl.conf 里的同名项
#      (systemd 把 /etc/sysctl.conf 当作 99-sysctl.conf 处理, 故本文件名需排在其后);
#   3) 出问题时删掉本文件即回滚, 不用还原主配置。
#
# ⚠ 三项网络缓冲的取值分歧(下面默认值比本仓库既有调优【更低】):
#     net.core.netdev_max_backlog  仓库 65535    / 本模板默认 16384
#     net.core.rmem_max            仓库 33554432 / 本模板默认 16777216
#     net.core.wmem_max            仓库 33554432 / 本模板默认 16777216
#   若实测网络吞吐不足需保留仓库的更高值, 在 env.yaml 置
#   node_tuning_keep_higher_net_buffers: true —— 那三项就不写进本文件, 沿用 sysctl.conf 的大值。

# ---- 连接与队列 ----
net.core.somaxconn = {{ node_tuning_somaxconn | default(32768) }}
{% if not (node_tuning_keep_higher_net_buffers | default(false) | bool) %}
net.core.netdev_max_backlog = {{ node_tuning_netdev_max_backlog | default(16384) }}
net.core.rmem_max = {{ node_tuning_rmem_max | default(16777216) }}
net.core.wmem_max = {{ node_tuning_wmem_max | default(16777216) }}
{% endif %}

# ---- 文件句柄 ----
fs.file-max = {{ node_tuning_file_max | default(12000500) }}

# ---- 用户命名空间(容器 rootless / 部分 GPU 场景需要) ----
user.max_user_namespaces = {{ node_tuning_max_user_namespaces | default(63359) }}

# ---- 临时端口范围 ----
# 起点 32768 恰在 NodePort 段(30000-32767)之上, 与本仓库
# net.ipv4.ip_local_reserved_ports = 30000-32767 的意图一致, 不冲突。
net.ipv4.ip_local_port_range = {{ node_tuning_ip_local_port_range | default('32768 60999') }}

# ---- keyring(容器镜像解密 / 内核密钥环) ----
kernel.keys.maxkeys = {{ node_tuning_keys_maxkeys | default(2000) }}
kernel.keys.maxbytes = {{ node_tuning_keys_maxbytes | default(2000000) }}

# ---- inotify(kubelet/containerd 监听大量文件) ----
fs.inotify.max_queued_events = {{ node_tuning_inotify_max_queued_events | default(1048576) }}
fs.inotify.max_user_instances = {{ node_tuning_inotify_max_user_instances | default(1048576) }}
fs.inotify.max_user_watches = {{ node_tuning_inotify_max_user_watches | default(1048576) }}

# ---- 内存映射(部分 AI 框架 / ES 需要) ----
vm.max_map_count = {{ node_tuning_max_map_count | default(262144) }}
