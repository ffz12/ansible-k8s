#!/bin/bash
# keepalived 健康检查: 本机 Harbor 是否【挂了】(探 127.0.0.1, 不探 VIP —— 判断的是本机该不该持 VIP)。
# 只把"真挂"判失败, "慢"不算: 推/拉大镜像时 ping 可能几秒没响应, 以前按超时判失败,
# VIP 在传输中途漂走, 请求分到两台上报 blob unknown / connection reset。
#   失败(返回 1): nginx 或 harbor-core 容器没在跑 / 连接被拒 / 返回 5xx
#   通过(返回 0): ping 返回 Pong, 或者只是超时(容器都在跑, 视为忙)
for c in nginx harbor-core; do
    [ "$(docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "$c" 2>/dev/null)" = "true" ] || exit 1
done
code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 https://127.0.0.1/api/v2.0/ping 2>/dev/null)"
rc=$?
[ "$code" = "200" ] && exit 0
[ "$rc" = "28" ] && exit 0          # 28 = 超时: 忙, 不切
exit 1                              # 连不上(7) / 5xx / 其它
