global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5000
    timeout client  30000
    timeout server  30000

frontend main
    bind *:{{ apiserver_lb_port }}
    mode tcp
    default_backend  k8s-api-backend
#监控连接数使用情况
listen stats
    bind *:1080
    mode http
    stats enable
    stats uri /stats
    stats auth admin:Admin@123+
    stats refresh 30s

backend k8s-api-backend
    balance     roundrobin # 使用轮询负载均衡算法
    # option tcp-check
    # check        - 启用健康检查
    # inter 3s     - 每3秒检查一次，默认2s
    # fall 3       - 连续3次失败标记为不可用，默认3
    # rise 2       - 连续2次成功恢复为可用，默认2
{# 后端必须是【apiserver 所在的 master】, 不是 LB 机器自己。
   原来遍历 groups['k8slb'] —— 当 LB 与 master 同机(在 master 上跑 haproxy)时碰巧能用,
   但 LB 独立部署时会把后端指向 LB 自己的 apiserver_port, 那里没有 apiserver -> 全连不通。
   与 nginx-ha 的 lb_upstream_servers 口径对齐: k8s_master + master_to_add - master_to_delete。 #}
{% set _api_backends = ((groups.k8s_master | default([])) + (groups.master_to_add | default([])))
                       | difference(groups.master_to_delete | default([])) | unique %}
{% for ip in _api_backends %}
    server  {{ hostvars[ip]['inventory_hostname'] }}  {{ hostvars[ip].ansible_host | default(ip) }}:{{ apiserver_port }}     check inter 5s rise 2 fall 3
{% endfor %}
