global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5000
    timeout client  30000
    timeout server  30000
    # 某台 master 挂掉后, 健康检查要 inter × fall 才把它摘出后端池(见下面 server 行)。这段
    # 窗口里 roundrobin 照样往它分连接 —— 3 台的话约 1/3 的新连接会失败, 每个还要等
    # timeout connect(5s)才报错。retries + redispatch 补上这一环: 连接后端失败时 haproxy
    # 自己换一台重试, 客户端无感。窗口再短也总有暴露, 这个才是真正消除失败的一半。
    # ⚠ 只对【建立连接失败】有效; 连接已建立后后端才挂的仍会断在客户端侧(要处理那种得加
    #   on-marked-down shutdown-sessions, 会主动断开 kubelet 的 watch, 行为变化大, 暂不动)。
    retries 3
    option redispatch

frontend main
    bind *:{{ apiserver_lb_port }}
    mode tcp
    default_backend  k8s-api-backend
#监控连接数使用情况
listen stats
    bind *:1080
    mode http
    stats enable
    stats uri /stats
    stats auth admin:Admin@123+
    stats refresh 30s

backend k8s-api-backend
    balance     roundrobin # 使用轮询负载均衡算法
    # option tcp-check
    # check        - 启用健康检查(只做 TCP 握手; apiserver 卡死但端口在听时照样算活)
    # inter 2s     - 每 2 秒检查一次
    # fall 2       - 连续 2 次失败标记为不可用 -> 最长 4 秒摘除(原 inter 5s fall 3 = 15 秒)
    # rise 2       - 连续2次成功恢复为可用，默认2
    # ⚠ 缩短窗口只是减少暴露时间, 消除失败靠上面 defaults 段的 retries + redispatch。
    #   本地 6443 探测抖动概率低, 故敢把 fall 收到 2; 跨网段探测的站点可自行调回。
{# 后端必须是【apiserver 所在的 master】, 不是 LB 机器自己。
   原来遍历 groups['k8slb'] —— 当 LB 与 master 同机(在 master 上跑 haproxy)时碰巧能用,
   但 LB 独立部署时会把后端指向 LB 自己的 apiserver_port, 那里没有 apiserver -> 全连不通。
   与 nginx-ha 的 lb_upstream_servers 口径对齐: k8s_master + master_to_add - master_to_delete。 #}
{% set _api_backends = ((groups.k8s_master | default([])) + (groups.master_to_add | default([])))
                       | difference(groups.master_to_delete | default([])) | unique %}
{% for ip in _api_backends %}
    server  {{ hostvars[ip]['inventory_hostname'] }}  {{ hostvars[ip].ansible_host | default(ip) }}:{{ apiserver_port }}     check inter 2s rise 2 fall 2
{% endfor %}
