global_defs {
   # 性能优化参数(学习 nginx-ha)
   vrrp_garp_master_refresh 60  # 主节点定期发送 GARP 包刷新 ARP 缓存
   vrrp_garp_master_repeat 2    # 每次发送的 GARP 包数量
   # ⚠ 这里原先还有一行 `script_security` —— keepalived 【没有这个指令】, 每次启动都报
   #   (Line 5) Unknown keyword 'script_security'。2026-09-17 现网 cpu200 日志确认, 且
   #   Sep 06 的旧日志里同样有, 不是新引入的。真正生效的是下面这行 enable_script_security。
   #   留着的害处: 每次启动一条警告, 且让人以为"脚本安全"是靠那行开的。已删。
   enable_script_security       # 脚本路径若被非 root 可写则拒绝以 root 执行
   script_user root             # 指定执行脚本的用户
}

{# _lb_entry_port 由 tasks/main.yaml 的 set_fact 提供(不在这里 {% set %} —— check_entry.sh
   是另一个模板, 读不到本模板的局部变量, 会渲出 PORT="" 让检查恒失败) #}
vrrp_script chk_entry {
    # 探【本机】入口端口 {{ _lb_entry_port }} 的 /livez。
    # 原 check_haproxy.sh 是 `ss -lntp | grep -q haproxy` —— 只看进程名, 8443 前端绑失败但
    # 1080 stats 起来了也算通过; 且 keepalived-only 形态下没有 haproxy 进程, 那个脚本恒失败
    # (三台降权一致 -> 相对优先级不变 -> VIP 照样落首台, 看着正常却永远检测不到 apiserver 死掉)。
    script "/etc/keepalived/check_entry.sh"
    interval 2              # 检测间隔
    timeout 2              # 脚本超时(避免卡死)
    rise 2                 # 连续成功 2 次才认为恢复
    fall 2                 # 连续失败 2 次才认为宕机
{% if (lb_vrrp_preempt_mode | default('nopreempt')) == 'nopreempt' %}
    # ⚠ nopreempt 模式【故意不配 weight】—— 这两者不能同时用, 否则故障转移直接失效。
    #   机制: 配了 weight 时, 检查失败只把【本机】priority 降低, instance 仍在发 advert;
    #   VIP 易手靠对端【抢占】。而 nopreempt 的语义正是"不抢占活着的 MASTER"(不看优先级) ——
    #   于是 MASTER 掉到 80、对端 90 也不动, VIP 卡在已坏的节点上。
    #   2026-09-17 现网实测(cluster C cpu200): apiserver 停 -> "Changing effective priority
    #   from 100 to 80" -> 【没有】Entering BACKUP -> VIP 一直留在 cpu200。
    #   不配 weight 时, 检查失败让 instance 进 FAULT: 停发 advert -> 对端按"MASTER 消失"接管
    #   (master-down 检测, 不是抢占, nopreempt 拦不住) -> 恢复后本机以 BACKUP 回来、被
    #   nopreempt 按住不抢回。故障能切、恢复不回切, 两头都满足。
    #
    #   ✔ 2026-09-17 现网实测通过(cluster C, 3 台 cpu200/201/202, keepalived-only + nopreempt)。
    #     停 cpu201 的 apiserver, keepalived 日志:
    #       17:42:16  Script `chk_entry` now returning 1
    #       17:42:18  VRRP_Script(chk_entry) failed (exited with status 1)
    #       17:42:18  (VI_1) Entering FAULT STATE          <- 停发 advert
    #       17:43:20  chk_entry now returning 0            <- apiserver 恢复
    #       17:43:22  VRRP_Script(chk_entry) succeeded
    #       17:43:22  (VI_1) Entering BACKUP STATE         <- 回来是 BACKUP 而非 MASTER
    #     同时 cpu200 拿到 VIP(priority 100, 不是末位的 cpu202/80 —— 选主顺序正确);
    #     cpu201 恢复后 check_entry.sh exit=0 但 VIP 仍在 cpu200, 确认【不回切】。
    #   ✔ 防抖也实测到了: 同一段日志里 17:40:38 returning 1 -> 17:40:40 returning 0 的瞬时抖动
    #     【没有】触发 FAULT —— fall 2 要求连续两次失败, 一轮就恢复的不算。
    #   (旁证: 重启节点时 VIP 同样正常漂移 —— 重启也是"停发 advert", 走同一条 master-down 路径。)
    # ⚠ 代价: 两台检查同时失败时都进 FAULT, 期间【没有任何节点持 VIP】。weight 式则总有一台
    #   持有(哪怕它自己也坏了)。前者更诚实, 但形态 B 冷启动需要 check_entry.sh 里的兜底
    #   (kubelet.conf 不存在时直接 exit 0), 否则集群建不出来 —— 见该脚本头部说明。
{% else %}
    # ⚠ |weight| 必须【大于】(台数-1) x priority 间距(下面按 10 递减) —— 与 55937c0 那条注释
    #   写反了。keepalived 把 weight 加到【本节点自己】的 priority 上, VRRP 再选【最高】者:
    #   weight -5 时首台失败只掉到 95, 仍是最高 -> VIP 不动, 健康检查等于装饰。
    #   (55937c0 说 -30 会"跨级"甩到末位也是算错: 首台掉到 70 时次高台是 90、末位 80, 选 90。)
    #   故按台数派生, 保证任意台数都够: N 台 -> -(N x 10)。已模拟 2-8 台的最坏情况(前 k 台连挂)。
    weight {{ lb_vrrp_check_weight | default(-((groups['k8slb'] | length) * 10)) }}
{% endif %}
}

vrrp_instance VI_1 {
    # 基础配置
    # state: nopreempt / preempt_delay 只在 BACKUP 下生效(见 defaults.yaml 的
    #   lb_vrrp_preempt_mode 注释), 故这两种模式下全部节点都渲染成 BACKUP,
    #   靠 priority 选主; immediate 模式保持原来的 MASTER 写法。
    state {{ 'MASTER' if (lb_vrrp_preempt_mode | default('delay')) == 'immediate' else 'BACKUP' }}
    interface {{ LB_IF_TMP.stdout }}  # 实际网卡名(自动探测)

    # 基于 VIP 哈希生成唯一 router_id (1-254)，避免同网段多套 LB 冲突
    virtual_router_id {{ (lbvip | regex_replace('\.', '') | int) % 254 + 1 }}

    # 动态优先级：k8slb 组第一个节点 100，第二个 90，第三个 80...
    # (学习 nginx-ha，替代原来所有节点写死 250 导致无法正常选主)
    priority {{ 100 - (groups['k8slb'].index(inventory_hostname) * 10) }}

    advert_int 1    # VRRP 心跳间隔，默认 1 秒
{% set _preempt = lb_vrrp_preempt_mode | default('delay') %}
{% if _preempt == 'nopreempt' %}
    nopreempt       # 原主恢复后【永不】抢回 VIP(需 state BACKUP, 已在上面处理)
{% elif _preempt == 'delay' %}
    # 原主恢复后等 {{ lb_vrrp_preempt_delay | default(10) }} 秒再抢回 —— 仍会回切, 只是防抖动。
    # 与 nopreempt 互斥, 二者都需 state BACKUP 才生效。
    preempt_delay {{ lb_vrrp_preempt_delay | default(10) }}
{% else %}
    # immediate: 不写 nopreempt / preempt_delay, 原主恢复立即抢回(VRRP 默认行为)
{% endif %}

    authentication {
        auth_type PASS
        # ⚠ keepalived 只取 auth_pass 的【前 8 字符】, 超出会在启动日志里报
        #     Truncating auth_pass to 8 characters
        #   原写法 'LB_VIP_' ~ <VIP去点> 前缀就占了 7 位, 实际生效只剩 1 位 —— 于是
        #   "基于 VIP 生成、避免多套 LB 冲突"这个意图【失效】: 任何 VIP 都得到 LB_VIP_1。
        #   改为把 VIP 后两段转成十六进制(每段 2 位, 共 4 位)+ 3 位前缀 = 7 位, 不被截断,
        #   同网段不同 VIP 也能区分。同一套 LB 内三台必须一致, 否则互相拒收 advert。
        auth_pass {{ 'VRP' ~ '%02X%02X' % (lbvip.split('.')[2] | int, lbvip.split('.')[3] | int) }}
    }
{% if lb_vrrp_unicast | default(true) | bool %}

    # ---- 单播模式(lb_vrrp_unicast=true, 默认) ----
    # 不依赖交换机对 224.0.0.18 的组播转发。现网踩过单向组播故障导致的永久双 MASTER,
    # 详见 group_vars/all/defaults.yaml 里 lb_vrrp_unicast 的注释。
    # src 取本机 ansible_host、peer 自动排除自己 —— 手填极易出错(现网手改时三台的
    # unicast_src_ip 全复制成同一个 IP, 非本机地址 bind 失败直接进 FAULT 状态)。
    unicast_src_ip {{ ansible_host | default(inventory_hostname) }}
    unicast_peer {
{% for _h in groups['k8slb'] if _h != inventory_hostname %}
        {{ hostvars[_h].ansible_host | default(_h) }}
{% endfor %}
    }
{% endif %}

    # 虚拟 IP: 掩码用 vip_prefix(默认 22,可在 inventory 覆盖)，绑到自动探测的网卡并打 label 便于识别
    virtual_ipaddress {
        {{ lbvip }}/{{ vip_prefix | default('22') }} dev {{ LB_IF_TMP.stdout }} label {{ LB_IF_TMP.stdout }}:0
    }

    # 健康检查绑定
    track_script {
        chk_entry
    }

    # 附加跟踪接口(网卡故障时触发切换)
    track_interface {
       {{ LB_IF_TMP.stdout }}
    }
}
