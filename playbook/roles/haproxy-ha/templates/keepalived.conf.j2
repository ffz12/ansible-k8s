global_defs {
   vrrp_garp_master_refresh 60  # 主节点定期发 GARP 刷新 ARP 缓存
   vrrp_garp_master_repeat 2    # 每次发送的 GARP 包数量
   enable_script_security       # 脚本路径被非 root 可写时拒绝以 root 执行
   script_user root             # 指定执行脚本的用户
}

{# _lb_entry_port 由 tasks/main.yaml 的 set_fact 提供, 不能在这里 {% set %}:
   check_entry.sh 是另一个模板, 读不到本模板的局部变量 #}
vrrp_script chk_entry {
    # 探本机入口端口 {{ _lb_entry_port }} 的 /livez(只看进程或端口在不在, 发现不了服务卡死)
    script "/etc/keepalived/check_entry.sh"
    interval 2              # 检测间隔
    timeout 2              # 脚本超时(避免卡死)
    rise 2                 # 连续成功 2 次才认为恢复
    fall 2                 # 连续失败 2 次才认为宕机
{% if (lb_vrrp_preempt_mode | default('nopreempt')) == 'nopreempt' %}
    # ⚠ nopreempt 模式不能配 weight, 否则故障转移失效: 配了 weight 检查失败只降本机优先级,
    #   VIP 要靠对端抢占才会走, 而 nopreempt 正是不抢占, VIP 会卡在坏节点上。
    #   不配 weight 时检查失败进 FAULT 停发 advert, 对端按"主消失"接管; 恢复后以 BACKUP 回来,
    #   不抢回 VIP。2026-09 现网 3 台实测通过。
    # 代价: 所有节点检查都失败时没有节点持 VIP。冷启动靠 check_entry.sh 里的兜底放行。
{% else %}
    # |weight| 必须大于 (台数-1) x 10(priority 按 10 递减), 否则首台失败后仍是最高, VIP 不动。
    #   故按台数派生: N 台 -> -(N x 10)。
    weight {{ lb_vrrp_check_weight | default(-((groups['k8slb'] | length) * 10)) }}
{% endif %}
}

vrrp_instance VI_1 {
    # nopreempt / preempt_delay 只在 BACKUP 下生效, 这两种模式全部渲染成 BACKUP、靠 priority 选主
    state {{ 'MASTER' if (lb_vrrp_preempt_mode | default('delay')) == 'immediate' else 'BACKUP' }}
    interface {{ LB_IF_TMP.stdout }}  # 实际网卡名(自动探测)

    # 由 VIP 派生 router_id (1-254)，避免同网段多套 LB 冲突
    virtual_router_id {{ (lbvip | regex_replace('\.', '') | int) % 254 + 1 }}

    # k8slb 组第一台 100，第二台 90，依次递减
    priority {{ 100 - (groups['k8slb'].index(inventory_hostname) * 10) }}

    advert_int 1    # VRRP 心跳间隔，默认 1 秒
{% set _preempt = lb_vrrp_preempt_mode | default('delay') %}
{% if _preempt == 'nopreempt' %}
    nopreempt       # 原主恢复后不抢回 VIP
{% elif _preempt == 'delay' %}
    # 原主恢复后等 {{ lb_vrrp_preempt_delay | default(10) }} 秒再抢回(仍会回切, 只是防抖)
    preempt_delay {{ lb_vrrp_preempt_delay | default(10) }}
{% else %}
    # immediate: 原主恢复立即抢回(VRRP 默认行为)
{% endif %}

    authentication {
        auth_type PASS
        # keepalived 只取前 8 位。按 VIP 后两段转十六进制生成(VRP + 4 位 = 7 位), 不同 VIP 不撞;
        # 同一套 LB 内各台必须一致。
        auth_pass {{ 'VRP' ~ '%02X%02X' % (lbvip.split('.')[2] | int, lbvip.split('.')[3] | int) }}
    }
{% if lb_vrrp_unicast | default(true) | bool %}

    # 单播(默认): 不依赖交换机转发 224.0.0.18 组播, 组播单向不通会出现双 MASTER。
    # src/peer 自动生成, 别手填(src 写成非本机地址会直接进 FAULT)。
    unicast_src_ip {{ ansible_host | default(inventory_hostname) }}
    unicast_peer {
{% for _h in groups['k8slb'] if _h != inventory_hostname %}
        {{ hostvars[_h].ansible_host | default(_h) }}
{% endfor %}
    }
{% endif %}

    # 掩码用 vip_prefix(默认 22)，绑到自动探测的网卡并打 label 便于识别
    virtual_ipaddress {
        {{ lbvip }}/{{ vip_prefix | default('22') }} dev {{ LB_IF_TMP.stdout }} label {{ LB_IF_TMP.stdout }}:0
    }

    track_script {
        chk_entry
    }

    # 网卡故障时也触发切换
    track_interface {
       {{ LB_IF_TMP.stdout }}
    }
}
