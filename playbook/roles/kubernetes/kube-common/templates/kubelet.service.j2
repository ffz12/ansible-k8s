[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ kube_bin_dir }}/kubelet
Restart=always
RestartSec=10
StartLimitInterval=0
KillMode=process
User=root
CPUAccounting=true
MemoryAccounting=true
# ⚠ 别在这里加 TasksMax —— 它管不到 Pod。
#   CRI 架构下 Pod 容器【不在】kubelet.service 的 cgroup 里: containerd 拉起容器,
#   cgroup 落在 kubepods.slice 下(本单元还是 KillMode=process)。所以在这儿声明
#   TasksMax 只抬高 kubelet 自己那个进程的上限, 对 Pod 的 pids.max 零影响。
#   (2026-09-14 曾据此错误前提加过一次, 已撤回。)
#
#   Pod pid 上限的真实链路:
#     containerd config*.toml.j2  SystemdCgroup = true  -> Pod cgroup 由 systemd 管
#     kubeadm-config.yaml.j2      podPidsLimit
#       填具体数字 -> kubelet 直接把 pids.max 写进 pod cgroup, 不看 systemd
#       填 -1       -> kubelet 【不写】, 继承 kubepods.slice -> 落到 systemd 的
#                      DefaultTasksMax(/etc/systemd/system.conf)
#   故 -1 反而比填一个大数字【更受限】; 现场在容器内实测到 pids.max=3000 就是这么来的。
#   要放开单 Pod 上限, 改 defaults.yaml 的 kubelet_pod_pids_limit(默认 50000),
#   而不是动这个文件。

[Install]
WantedBy=multi-user.target

