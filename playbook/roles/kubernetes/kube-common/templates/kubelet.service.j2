[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ kube_bin_dir }}/kubelet
Restart=always
RestartSec=10
StartLimitInterval=0
KillMode=process
User=root
CPUAccounting=true
MemoryAccounting=true
# kubelet 名下挂着本机全部容器进程, 不能吃 systemd 的全局默认。
# 不声明时用 /etc/systemd/system.conf 的 DefaultTasksMax(Ubuntu 默认 15%,
# 即 kernel.pid_max 的 15%; 本仓库 sysctl.conf 设 pid_max=1000001 -> 约 15 万)。
# 与 containerd.service / cri-docker.service 的写法对齐 —— 那两个早就声明了
# TasksMax=infinity, 只有 kubelet 一直漏着, 于是现场靠手工改 system.conf 的
# DefaultTasksMax 来兜。改在单元里更精准: 只影响 kubelet, 不动这台机器上其它
# 单元的默认, 也不需要 systemctl daemon-reexec(那是重新执行 PID 1)。
# ⚠ infinity 等于放弃这层保护, fork 炸弹可打满整机 pid。单 Pod 那层的上限另有
#   其人管: kubeadm-config 的 podPidsLimit(见 defaults.yaml 的
#   kubelet_pod_pids_limit, 默认 50000 / kubelet_unlimited_pids 开关)。
# ⚠ 仅 systemd 226+ 支持 TasksMax; 更老的版本会因无法识别而拒绝加载该单元。
TasksMax=infinity

[Install]
WantedBy=multi-user.target

