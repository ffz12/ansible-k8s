# === InitConfiguration ===
apiVersion: kubeadm.k8s.io/v1beta4
bootstrapTokens:
- groups:
  - system:bootstrappers:kubeadm:default-node-token
  token: abcdef.0123456789abcdef
  ttl: 24h0m0s
  usages:
  - signing
  - authentication
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host }}   # ← 始终设置为本机 IP
  bindPort: {{ apiserver_port }}
nodeRegistration:
  criSocket: {{ kube_criSocket }}
  imagePullPolicy: IfNotPresent
  imagePullSerial: true
  name: {{ inventory_hostname }}
  taints: null
timeouts:
  controlPlaneComponentHealthCheck: 4m0s
  discovery: 5m0s
  etcdAPICall: 2m0s
  kubeletHealthCheck: 4m0s
  kubernetesAPICall: 1m0s
  tlsBootstrap: 5m0s
  upgradeManifests: 5m0s
---
# === ClusterConfiguration ===
apiVersion: kubeadm.k8s.io/v1beta4
{% if lbvip is defined %}
controlPlaneEndpoint: "{{ lbvip }}:{{ apiserver_lb_port }}"
{% endif %}
caCertificateValidityPeriod: 876000h
certificateValidityPeriod: 876000h
certificatesDir: /etc/kubernetes/pki
clusterName: kubernetes
apiServer:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0                 # apiserver 默认已监听 0.0.0.0,这里显式写一份
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0                 # 默认 127.0.0.1;改 0.0.0.0 才能远程抓 10257 metrics
    # 走 CSR 签发的证书(kubelet client / kubelet serving)有效期。默认 8760h(1y) ——
    # 与上面 caCertificateValidityPeriod/certificateValidityPeriod(876000h=100y)不一致,
    # 导致 kubelet 那两张证书 1 年就到期。这里对齐 100 年。
    # ⚠ 副作用: kubelet-csr-approver 硬编码上限 367 天, 设成 100 年后它会拒批所有 serving CSR,
    #   故不能与该审批器共用; serving CSR 改由 playbook/kubelet-serving-cert.yaml 人工批
    #   (100 年有效期下基本是一次性的事)。
    - name: cluster-signing-duration
      value: "{{ kube_signing_duration }}"
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0                 # 默认 127.0.0.1;改 0.0.0.0 才能远程抓 10259 metrics
dns: {}
encryptionAlgorithm: RSA-2048
etcd:
  external:
    endpoints:
{% for host in etcd_cluster_members | default([]) %}
{%   if host in hostvars and hostvars[host].get('ansible_host') %}
    - https://{{ hostvars[host]['ansible_host'] }}:2379
{%   endif %}
{% endfor %}    
    caFile: {{ kube_config_dir }}/pki/etcd/ca.crt
    certFile: {{ kube_config_dir }}/pki/kube-apiserver-etcd-client.crt
    keyFile: {{ kube_config_dir }}/pki/kube-apiserver-etcd-client.key
imageRepository: {{ kube_image_repository }}
kind: ClusterConfiguration
kubernetesVersion: v{{ k8s_version }}
networking:
  dnsDomain: {{ dns_domain }}
  serviceSubnet: {{ service_subnet }}
  podSubnet: {{ pod_subnet }}
---
# === KubeProxyConfiguration ===
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: {{ kube_proxy_mode }}
---
# === KubeletConfiguration ===
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
containerRuntimeEndpoint: "{{ kube_criSocket }}"
{% if enable_nodelocaldns | default(false) | bool %}
# 启用 NodeLocal DNSCache 时, Pod 的 DNS 必须指到本机 link-local 缓存(而非 coredns ClusterIP),
# 否则装了 nodelocaldns 也不生效 —— 查询链: Pod -> {{ nodelocaldns_ip }}(本地) -> CoreDNS。
# 与 playbook/nodelocaldns.yaml 配套; 改这里需重启 kubelet 才生效。
clusterDNS:
  - {{ nodelocaldns_ip }}
{% endif %}
cpuManagerPolicy: {{ kubelet_cpu_manager_policy }}
{% if kubelet_cpu_manager_policy == 'static' and (kubelet_cpu_align_by_socket | default(false) | bool) %}
cpuManagerPolicyOptions:
  align-by-socket: "true"          # 要求 sockets<=NUMA 节点数,否则 kubelet 起不来
featureGates:
  CPUManagerPolicyAlphaOptions: true
{% endif %}

#驱逐策略(内存阈值可在 env.yaml 调; 磁盘/pid 不随内存伸缩故固定)
evictionSoft:
  memory.available: {{ kubelet_eviction_soft_mem }}    # 低于此且持续超宽限期才驱逐
  nodefs.available: 10%       # 防止磁盘写满导致节点 NotReady
  nodefs.inodesFree: 5%
evictionSoftGracePeriod:
  memory.available: {{ kubelet_eviction_soft_grace }}
  nodefs.available: 1m30s
  nodefs.inodesFree: 1m30s

evictionHard:
  memory.available: {{ kubelet_eviction_hard_mem }}    # 低于此立即驱逐(无宽限)
  pid.available: 10%
  nodefs.available: 10%
  nodefs.inodesFree: 5%
evictionMaxPodGracePeriod: {{ kubelet_eviction_max_pod_grace }}
evictionPressureTransitionPeriod: {{ kubelet_eviction_pressure_transition }}

kubeReserved:
  cpu: "{{ kubelet_kube_reserved_cpu }}"
  memory: "{{ kubelet_kube_reserved_mem }}"


systemReserved:
  cpu: "{{ kubelet_system_reserved_cpu }}"
  memory: "{{ kubelet_system_reserved_mem }}"
maxPods: {{ kubelet_max_pods }}
podPidsLimit: {{ kubelet_pod_pids_limit }}
containerLogMaxSize: {{ kubelet_container_log_max_size }}
containerLogMaxFiles: {{ kubelet_container_log_max_files }}
rotateCertificates: true
serverTLSBootstrap: true                 # kubelet 向集群 CA 申请 10250 serving 证书(替自签名);
                                         # 需审批 kubernetes.io/kubelet-serving CSR。存量集群用
                                         # playbook/kubelet-serving-cert.yaml 下发+审批。
{% if kubelet_security_enhancement | default(false) | bool %}
# ---- 安全加固(CIS 基线; env.yaml: kubelet_security_enhancement=true 开启) ----
readOnlyPort: 0                        # 关闭只读端口 10255(无认证)
protectKernelDefaults: true            # 内核参数不符即报错,不静默修改
eventRecordQPS: 1
streamingConnectionIdleTimeout: 5m     # exec/attach/port-forward 空闲超时
makeIPTablesUtilChains: true
tlsCipherSuites:
  - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
{% endif %}
logging:
  flushFrequency: 5000000000 # 5s
  options:
    json:
      infoBufferSize: "0"
  verbosity: 0
shutdownGracePeriod: {{ kubelet_shutdown_grace }}             # 节点关机时给 Pod 的优雅退出时间
shutdownGracePeriodCriticalPods: {{ kubelet_shutdown_grace_critical }}
