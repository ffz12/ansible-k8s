# 由 roles/device-plugin 渲染, 手改会被覆盖(改变量: roles/device-plugin/defaults/main.yaml 或 env.yaml)
# nodeAffinity 用的 {{ nvidia_device_plugin_node_label }}=true 由 k8s-node-labels.yaml 按 accelerator_type 打。
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nvidia-device-plugin-daemonset
  namespace: {{ device_plugin_namespace }}
spec:
  selector:
    matchLabels:
      name: nvidia-device-plugin-ds
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        name: nvidia-device-plugin-ds
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: {{ nvidia_device_plugin_node_label }}
                operator: In
                values:
                - "true"
      tolerations:
      - key: CriticalAddonsOnly
        operator: Exists
      - key: nvidia.com/gpu
        operator: Exists
        effect: NoSchedule
      priorityClassName: "system-node-critical"
      containers:
      - image: {{ nvidia_device_plugin_image }}
        imagePullPolicy: IfNotPresent
        name: nvidia-device-plugin-ctr
        env:
          # 初始化失败(如驱动没装好)时不退出, 让 Pod 留着便于排查, 而不是 CrashLoop
          - name: FAIL_ON_INIT_ERROR
            value: "false"
        securityContext:
          # 与现网一致。上游原版是 allowPrivilegeEscalation: false + drop ALL,
          # 现网改成特权是当时驱动/toolkit 有问题时的绕法, 这里保持现状不动。
          privileged: true
        volumeMounts:
          - name: device-plugin
            mountPath: /var/lib/kubelet/device-plugins
          # 与现网一致: 容器内找不到 libnvidia-ml 时要从宿主机挂进来
          - name: lib-nvidia
            mountPath: /usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1
            readOnly: true
      volumes:
        - name: device-plugin
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: lib-nvidia
          hostPath:
            path: /lib/x86_64-linux-gnu/libnvidia-ml.so.1
