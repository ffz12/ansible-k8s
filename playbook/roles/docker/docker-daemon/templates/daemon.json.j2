{
 "exec-opts": ["native.cgroupdriver=systemd"],
 "log-driver": "json-file",
 "log-opts": {
            "max-file": "3",
            "max-size": "10m"
             },
 "data-root": "{{ data_root }}",
{% if docker_bip is defined %}
 "bip": "{{ docker_bip }}",
{% endif %}
{% if docker_default_address_pools is defined %}
 "default-address-pools": [
    {% for pool in docker_default_address_pools %}
    {"base": "{{ pool.base }}", "size": {{ pool.size }}}{{ "," if not loop.last else "" }}
    {% endfor %}
 ],
{% endif %}
 "insecure-registries": [
    {% for item in harbor_instances %}
    "{{ item.dns }}"{{ "," if not loop.last else "" }}
    {% endfor %}
 ],
 "registry-mirrors":[
     "https://docker.hlmirror.com",
     "https://docker.1ms.run",
     "https://proxy.1panel.live",
     "https://docker.1ms.run",
     "https://docker.m.daocloud.io",
     "https://hub1.nat.tf",
     "https://hub2.nat.tf",
     "https://docker.ketches.cn"

 ],
 "live-restore": true
}

