{# 2026-09-16: 改为发行版包安装后, 路径与运行用户都不再来自 nginx_dir/nginx_logs_dir。
   · user: Debian 系包建的是 www-data, RHEL 系是 nginx —— 写死会报 getpwnam() failed,
     故取 install-package.yml 探测出的 nginx_run_user。
   · 日志目录固定 /var/log/nginx(包自带, 已建好并配了 logrotate)。
   · ⚠ 必须保留 modules-enabled 的 include: Debian/Ubuntu 的 stream 模块是【动态加载】的
     (libnginx-mod-stream 往 /etc/nginx/modules-enabled/ 放 .conf 做 load_module),
     整份覆盖 nginx.conf 时漏掉这行, 装了模块照样报 unknown directive "stream"。
     glob 匹配不到文件时 nginx 不报错, 所以两种发行版都无条件写。 #}
user {{ nginx_run_user | default('nginx') }};
worker_processes auto;

worker_rlimit_nofile 65535;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

include /etc/nginx/modules-enabled/*.conf;
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 8192;
    use epoll;
    multi_accept on;
}

stream {
    log_format main '$remote_addr [$time_local] '
                    '$protocol $status $bytes_sent $bytes_received '
                    '$session_time "$upstream_addr"';

    access_log /var/log/nginx/k8s-access.log main buffer=16k;
    open_log_file_cache max=1000 inactive=60s;

    upstream k8s-apiserver {
        least_conn;
        {% for host in lb_upstream_servers %}
        server {{ hostvars[host].ansible_host | default(host) }}:{{ apiserver_port }} max_fails=3 fail_timeout=30s;
        {% endfor %}
    }

    server {
        listen {{ apiserver_lb_port }} so_keepalive=on;
        proxy_pass k8s-apiserver;
        proxy_timeout 1h;
        proxy_buffer_size 16k;
    }
}
