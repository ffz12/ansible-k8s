# roles/nodelocaldns/templates/nodelocaldns.yaml.j2
# NodeLocal DNSCache —— 忠实复刻现网(KubeKey/KubeSphere 风味)配置, 参数化。
# 查询链: Pod(clusterDNS=169.254.25.10) -> nodelocaldns 本地缓存 -> CoreDNS(svc {{ nodelocaldns_coredns_svc }})。
# 单绑 {{ nodelocaldns_ip }}; 转发目标 = 运行时查到的 coredns ClusterIP({{ coredns_svc_ip }})。
# 站点定制(桩区/hosts)由 nodelocaldns_stub_zones / nodelocaldns_hosts 提供(默认空, env.yaml 覆盖)。
apiVersion: v1
kind: ServiceAccount
metadata:
  name: nodelocaldns
  namespace: kube-system
  labels:
    addonmanager.kubernetes.io/mode: Reconcile
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nodelocaldns
  namespace: kube-system
  labels:
    addonmanager.kubernetes.io/mode: Reconcile
data:
  Corefile: |
{% for z in nodelocaldns_stub_zones | default([]) %}
    {{ z.zone }}:53 {
        errors
        cache {{ z.cache | default(30) }}
        reload
        bind {{ nodelocaldns_ip }}
        forward . {{ z.forward }}
        loop
{% if z.health | default(false) %}
        health {{ nodelocaldns_ip }}:{{ nodelocaldns_health_port }}
{% endif %}
    }
{% endfor %}
    {{ dns_domain }}:53 {
        errors
        cache {
            success 9984 30
            denial 9984 5
        }
        reload
        loop
        bind {{ nodelocaldns_ip }}
        forward . {{ coredns_svc_ip }}
        health {{ nodelocaldns_ip }}:{{ nodelocaldns_health_port }}
    }
    in-addr.arpa:53 {
        errors
        cache 30
        reload
        loop
        bind {{ nodelocaldns_ip }}
        forward . {{ coredns_svc_ip }}
    }
    ip6.arpa:53 {
        errors
        cache 30
        reload
        loop
        bind {{ nodelocaldns_ip }}
        forward . {{ coredns_svc_ip }}
    }
    .:53 {
        errors
        cache 30
        reload
        loop
        bind {{ nodelocaldns_ip }}
        forward . {{ coredns_svc_ip }}
{% if nodelocaldns_hosts | default([]) | length > 0 %}
        hosts {
{% for h in nodelocaldns_hosts %}
{% for n in h.names %}
            {{ h.ip }} {{ n }}
{% endfor %}
{% endfor %}
            fallthrough
        }
{% endif %}
    }
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nodelocaldns
  namespace: kube-system
  labels:
    addonmanager.kubernetes.io/mode: Reconcile
    k8s-app: kube-dns
spec:
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      k8s-app: nodelocaldns
  updateStrategy:
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 20%
    type: RollingUpdate
  template:
    metadata:
      labels:
        k8s-app: nodelocaldns
    spec:
      priorityClassName: system-cluster-critical
      serviceAccountName: nodelocaldns
      hostNetwork: true
      dnsPolicy: Default
      terminationGracePeriodSeconds: 0
      nodeSelector:
        kubernetes.io/os: linux
      tolerations:
      - effect: NoSchedule
        operator: Exists
      - effect: NoExecute
        operator: Exists
      - key: CriticalAddonsOnly
        operator: Exists
      containers:
      - name: node-cache
        image: {{ nodelocaldns_image }}
        imagePullPolicy: IfNotPresent
        args:
        - -localip
        - {{ nodelocaldns_ip }}
        - -conf
        - /etc/coredns/Corefile
        - -upstreamsvc
        - {{ nodelocaldns_coredns_svc }}
        - -metrics-listen-address
        - {{ nodelocaldns_metrics_listen }}
        securityContext:
          privileged: true
        resources:
          limits:
            memory: 200Mi
          requests:
            cpu: 100m
            memory: 70Mi
        ports:
        - containerPort: 53
          name: dns
          protocol: UDP
        - containerPort: 53
          name: dns-tcp
          protocol: TCP
        livenessProbe:
          httpGet:
            host: {{ nodelocaldns_ip }}
            path: /health
            port: {{ nodelocaldns_health_port }}
            scheme: HTTP
          failureThreshold: 10
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          httpGet:
            host: {{ nodelocaldns_ip }}
            path: /health
            port: {{ nodelocaldns_health_port }}
            scheme: HTTP
          failureThreshold: 10
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        volumeMounts:
        - mountPath: /etc/coredns
          name: config-volume
        - mountPath: /run/xtables.lock
          name: xtables-lock
      volumes:
      - name: config-volume
        configMap:
          name: nodelocaldns
      - name: xtables-lock
        hostPath:
          path: /run/xtables.lock
          type: FileOrCreate
