# ============================================================================
#  {{ osinit_chrony_conf }} —— 由 Ansible os-init 角色生成, 请勿手工修改
#  交付标准: 集群时间统一对齐, 最大差 {{ osinit_time_max_offset }} 秒, UTC 时区
# ============================================================================

{# ==========================================================================
   自建内网 NTP server 特性(可选)
   开关 = inventory 的 [chronyserver] 组。该组为空时下面条件块全不生效,
   渲染结果与本特性引入前逐字节一致 —— 现有站点不受影响。
   ⚠ 本段必须与 init 角色的 chrony.conf.j2 保持一致: 两个角色写同一个文件,
     os-init 在 init 之后跑(见 os-init.yaml 头部执行顺序), 只改一边会被后者覆盖,
     且 allow/local 被抹掉时【不报错】, 只表现为客户端集体掉同步。
   ========================================================================== #}
{% set chrony_servers = groups['chronyserver'] | default([]) %}
{% set is_chrony_server = inventory_hostname in chrony_servers %}
{% if chrony_servers | length > 0 and not is_chrony_server %}
# 集群内有自建 NTP server([chronyserver] 组), 本机作为客户端指向它
{% for h in chrony_servers %}
server {{ hostvars[h].ansible_host | default(h) }} iburst
{% endfor %}
{% else %}
{% for s in osinit_ntp_servers %}
server {{ s }} iburst
{% endfor %}
{% endif %}

# 记录系统时钟快慢速率
driftfile /var/lib/chrony/chrony.drift

# 前三次更新若偏差 >1 秒则直接步进校正(而非缓慢 slew), 保证快速对齐
makestep 1.0 3

# 同步硬件 RTC, 保证重启后时间不跑偏
rtcsync

# 允许步进的最大修正量(不限制, 交付初期机器时间可能差很多)
maxupdateskew 100.0

logdir /var/log/chrony
{% if is_chrony_server %}

# ==================== 以下仅 [chronyserver] 组的机器才渲染 ====================
{# chrony 默认拒绝所有请求; 漏了 allow 的症状是 server 自己 tracking 正常、
   客户端全是 ^? 不可达。缺 chrony_allow_networks 由 tasks/time.yaml 的 assert 拦。 #}
{% for net in chrony_allow_networks | default([]) %}
allow {{ net }}
{% endfor %}
{% if chrony_server_serve_when_unsynced | default(true) | bool %}
# 上游断了也继续对下服务, 保证交付标准「集群内最大时间差 {{ osinit_time_max_offset }} 秒」
# 在外网不通时依然成立(全集群跟着本机的钟走)。stratum 越大越不权威, 真源恢复后自动让位。
local stratum {{ chrony_server_local_stratum | default(10) }}
{% endif %}
{% if chrony_server_bindaddress | default('') | trim | length > 0 %}
# 只在指定 IP 上监听 udp 123(多网卡机器钉到管理网)
bindaddress {{ chrony_server_bindaddress }}
{% endif %}
{% endif %}
